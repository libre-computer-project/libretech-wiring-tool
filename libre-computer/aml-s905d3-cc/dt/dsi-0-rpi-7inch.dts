/*
 * Summary: Raspberry Pi Touch Display 2 on DSI connector 0
 *
 * Requires: dsi-0
 *
 * Resource-requires: bus:mipi_dsi
 * Resource-provides: i2c:i2c3@0x45, i2c:i2c3@0x5d, label:backlight
 *
 * Notes:
 *   The panel MCU at I2C 0x45 owns reset and the backlight PWM.
 *   Touch is a Goodix GT911 at I2C 0x5d. Its reset is the MCU's
 *   second GPIO (high releases it); the connector carries no touch
 *   interrupt, so the driver polls.
 *   Connector I2C is I2C_M3 (i2c3, GPIOA_14/15), pins 20 and 21.
 *   Power is the board VCC_3V3 on pins 22 and 23.
 *   Lane count is the raspberrypi,dsi-7inch driver descriptor (2).
 *   Pins 17 and 18 are not claimed.
 *   The Solitude base DTB already enables i2c3, so this fragment
 *   does not. Setting status here would make the overlay the I2C3
 *   bus provider and pull this panel in behind the camera overlay.
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/clock/g12a-clkc.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "libre-computer,aml-s905d3-cc",
		"libretech,aml-s905d3-cc",
		"amlogic,s905d3",
		"amlogic,sm1";

	fragment@0 {
		target = <&i2c3>;

		__overlay__ {
			pinctrl-0 = <&i2c3_sda_a_pins>, <&i2c3_sck_a_pins>;
			pinctrl-names = "default";

			display_mcu: regulator@45 {
				compatible = "raspberrypi,touchscreen-panel-regulator-v2";
				reg = <0x45>;
				gpio-controller;
				#gpio-cells = <2>;
				#pwm-cells = <3>;
			};

			touchscreen@5d {
				compatible = "goodix,gt911";
				reg = <0x5d>;
				reset-gpios = <&display_mcu 1 GPIO_ACTIVE_HIGH>;
			};
		};
	};

	fragment@1 {
		target-path = "/";

		__overlay__ {
			backlight: backlight {
				compatible = "pwm-backlight";
				pwms = <&display_mcu 0 200000 0>;
				brightness-levels = <0 31>;
				num-interpolated-steps = <31>;
				default-brightness-level = <15>;
			};
		};
	};

	fragment@2 {
		target = <&mipi_dsi>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * GP0 at 1 GHz: the bit clock, and the encoder's 83.33 MHz
			 * pixel clock (the panel mode's) through VCLK2. The base
			 * gives GP0 no rate.
			 */
			assigned-clocks = <&clkc CLKID_GP0_PLL>,
					  <&clkc CLKID_MIPI_DSI_PXCLK_SEL>,
					  <&clkc CLKID_MIPI_DSI_PXCLK>,
					  <&clkc CLKID_CTS_ENCL_SEL>,
					  <&clkc CLKID_VCLK2_SEL>;
			assigned-clock-parents = <0>,
						 <&clkc CLKID_GP0_PLL>,
						 <0>,
						 <&clkc CLKID_VCLK2_DIV1>,
						 <&clkc CLKID_GP0_PLL>;
			assigned-clock-rates = <1000000000>,
					       <0>,
					       <1000000000>,
					       <0>,
					       <0>;

			panel@0 {
				compatible = "raspberrypi,dsi-7inch", "ilitek,ili9881c";
				reg = <0>;
				power-supply = <&vcc_3v3>;
				reset-gpios = <&display_mcu 0 GPIO_ACTIVE_LOW>;
				backlight = <&backlight>;

				port {
					panel_in: endpoint {
						remote-endpoint = <&dsi_panel_out>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&mipi_dsi_panel_port>;

		__overlay__ {
			dsi_panel_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};
