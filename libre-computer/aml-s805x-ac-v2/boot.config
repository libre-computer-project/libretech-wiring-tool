# SPDX-License-Identifier: MIT
# What this board's BootROM boots from. Read by flashing tools; see docs/packaging.md.
# EMMC_BOOT_PARTITIONS: yes = eMMC boot0/boot1 can hold the bootloader;
#   no = the BootROM reads the user area only; unknown = not shown, treated as no.
# GXL: not tested; the user area (sector 1) is known to boot.
EMMC_BOOT_PARTITIONS=unknown
