/*
 * Summary: spi-cc-2cs-mhs3528
 *
 * Pins (Header.Pin  Name  Pad  Ref — cross-ref gpio.map):
 *   7J1.11   GPIOAO_8*     F17     I2SOUT-CH23
 *   7J1.18   GPIOX_15      C7      UART_A_RTS_N
 *   7J1.22   GPIOX_0       A2      WIFI_SD_D0
 *
 * Requires: spi-cc-2cs
 *
 * Notes:
 * Display stack: tinydrm (DRM tiny / panel) preferred; staging fbtft is the
 * legacy fallback when both are built. Compatible order is tinydrm-first.
 * Properties tagged "fbtft/legacy" are ignored by tinydrm (CONFIG_FB_TFT_* only).
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/meson-gxl-gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/amlogic,meson-gxl-gpio-intc.h>

/ {
	compatible = "libre-computer,aml-s905x-cc",
		"libretech,aml-s905x-cc",
		"libre-computer,aml-s905x-cc-v2",
		"libretech,aml-s905x-cc-v2",
		"libre-computer,aml-s905x-cc-v3",
		"libretech,aml-s905x-cc-v3",
		"amlogic,s905x",
		"amlogic,meson-gxl";

	fragment@0 {
		target = <&cec_AO>;
		
		__overlay__ {
			status = "disabled";
		};
	};
	
	fragment@1 {
		target = <&pinctrl_aobus>;

		__overlay__ {
			xpt2046_pendown_pins: xpt2046-pendown-pins {
				mux {
					groups = "GPIOAO_8";
					function = "gpio_aobus";
					bias-pull-up;
					output-disable;
				};
			};
		};
	};

	fragment@2 {
		target = <&spicc>;
		
		__overlay__ {

			display@0 {
				compatible = "waveshare,rpi-lcd-35",	/* tinydrm: drm/tiny/ili9486 */
					"ilitek,ili9486";	/* fbtft/legacy: staging/fbtft/fb_ili9486 */
				reg = <0>;
				spi-max-frequency = <41666666>;
				reset-gpios = <&gpio GPIOX_0 GPIO_ACTIVE_HIGH>;
				dc-gpios = <&gpio GPIOX_15 GPIO_ACTIVE_HIGH>;
				status = "okay";
			};

			touchscreen@1 {
				compatible = "ti,ads7846";
				/*
				 * GPIOAO_8 is explicitly muxed to GPIO (gpio_aobus,
				 * function 0) by fragment@1 so pendown-gpio and the
				 * gpio_intc edge below do not depend on whatever mux
				 * the bootloader happened to leave. Selecting
				 * function 0 also clears the cec_ao bit on this pad,
				 * the function fragment@0 disables to free the pin.
				 */
				pinctrl-names = "default";
				pinctrl-0 = <&xpt2046_pendown_pins>;
				reg = <1>;
				spi-max-frequency = <1302084>;
				interrupt-parent = <&gpio_intc>;
				interrupts = <IRQID_GPIOAO_8 IRQ_TYPE_EDGE_FALLING>;
				pendown-gpio = <&gpio_ao GPIOAO_8 GPIO_ACTIVE_LOW>;
				ti,x-plate-ohms = /bits/ 16 <60>;
				ti,pressure-max = /bits/ 16 <255>;
				touchscreen-swapped-x-y;
				touchscreen-inverted-x;
				touchscreen-min-x = <180>;
				touchscreen-size-x = <3880>;
				touchscreen-min-y = <240>;
				touchscreen-size-y = <3940>;
				wakeup-source;
				status = "okay";
			};
		};
	};
};
