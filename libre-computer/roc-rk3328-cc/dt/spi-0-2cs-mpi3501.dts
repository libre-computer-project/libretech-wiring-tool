/*
 * Summary: ILI9486 based 3.5" touchscreen on 40P header J1 with tuning for MPI3501
 *
 * Pins (Header.Pin  Name  Pad  Ref — cross-ref gpio.map):
 *   ?.?    RK_PA2        ?       (not in gpio.map)
 *   ?.?    RK_PA5        ?       (not in gpio.map)
 *   ?.?    RK_PC4        ?       (not in gpio.map)
 *
 * Requires: spi-0-2cs
 *
 * Notes:
 * Display stack: tinydrm (DRM tiny / panel) preferred; staging fbtft is the
 * legacy fallback when both are built. Compatible order is tinydrm-first.
 * Properties tagged "fbtft/legacy" are ignored by tinydrm (CONFIG_FB_TFT_* only).
 *  ?.?    RK_PA2        ?       (not in gpio.map)
 *  ?.?    RK_PA5        ?       (not in gpio.map)
 *  ?.?    RK_PC4        ?       (not in gpio.map)
 * ?.?    RK_PA2        ?       (not in gpio.map)
 * ?.?    RK_PA5        ?       (not in gpio.map)
 * ?.?    RK_PC4        ?       (not in gpio.map)
 * Requires spi0-cs1 overlay
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/interrupt-controller/irq.h>
/*
 * 11 TPIRQ GPIO2_C4
 * 18 I/D R GPIO3_A5 
 * 22 Reset GPIO0_A2
 */

/ {
	compatible = "libre-computer,roc-rk3328-cc",
		"libretech,roc-rk3328-cc",
		"libre-computer,roc-rk3328-cc-v2",
		"libretech,roc-rk3328-cc-v2",
		"firefly,roc-rk3328-cc",
		"rockchip,rk3328";

	fragment@0 {
		target = <&spi0>;
		
		__overlay__ {

			display@0 {
				compatible = "waveshare,rpi-lcd-35",	/* tinydrm: drm/tiny/ili9486 */
					"ilitek,ili9486";	/* fbtft/legacy: staging/fbtft/fb_ili9486 */
				reg = <0>;
				spi-max-frequency = <30000000>;
				reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
				dc-gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
				status = "okay";
			};

			touchscreen@1 {
				compatible = "ti,ads7846";
				pinctrl-names = "default";
				pinctrl-0 = <&i2s1_sdio1>;
				reg = <1>;
				spi-max-frequency = <2000000>;
				interrupt-parent = <&gpio2>;
				interrupts = <20 IRQ_TYPE_EDGE_FALLING>;
				pendown-gpio = <&gpio2 RK_PC4 GPIO_ACTIVE_LOW>;
				ti,x-plate-ohms = /bits/ 16 <60>;
				ti,pressure-max = /bits/ 16 <255>;
                                touchscreen-swapped-x-y;
                                touchscreen-inverted-x;
                                touchscreen-min-x = <300>;
                                touchscreen-size-x = <3850>;
                                touchscreen-min-y = <240>;
                                touchscreen-size-y = <3900>;
				wakeup-source;
				status = "okay";
			};
		};
	};
};
