/*
 * Summary: Soft PPS on 40P header J1 pin 28
 *
 * Pins (Header.Pin  Name  Pad  Ref — cross-ref gpio.map):
 *   J1.28   GPIO2_A5      N20     I2C1_SCL_PMIC
 *   ?.?    RK_PD4        ?       (not in gpio.map)
 *
 * Notes:
 *  J1.28   GPIO2_A5      N20     I2C1_SCL_PMIC
 *  ?.?    RK_PD4        ?       (not in gpio.map)
 * J1.28   GPIO2_A5      N20     I2C1_SCL_PMIC
 * ?.?    RK_PD4        ?       (not in gpio.map)
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
/*
 * 7 1-28 CLKOUT GPIO1_D4
 */

/ {
	compatible = "libre-computer,roc-rk3328-cc",
		"libretech,roc-rk3328-cc",
		"libre-computer,roc-rk3328-cc-v2",
		"libretech,roc-rk3328-cc-v2",
		"firefly,roc-rk3328-cc",
		"rockchip,rk3328";

	fragment@0 {
		target-path = "/";

		__overlay__ {
			pps_gpio: pps-gpio {
				compatible = "pps-gpio";
				pinctrl-names = "default";
				gpios = <&gpio1 RK_PD4 GPIO_ACTIVE_HIGH>;
				assert-rising-edge;
				status = "okay";
			};
		};
	};
};
