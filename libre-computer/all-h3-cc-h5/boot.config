# SPDX-License-Identifier: MIT
# What this board's BootROM boots from. Read by flashing tools; see docs/packaging.md.
# EMMC_BOOT_PARTITIONS: yes = eMMC boot0/boot1 can hold the bootloader;
#   no = the BootROM reads the user area only; unknown = not shown, treated as no.
# H5: tested; the BootROM reads the eMMC user area (sector 16) only, and setting
# the eMMC boot partition does not redirect it.
EMMC_BOOT_PARTITIONS=no
# SPI_NOR: yes = SPI NOR fitted, it holds the bootloader; no = none fitted;
#   unknown = varies by build or not shown, treated as no.
SPI_NOR=no
