# PURPOSE: Manage the application and removal of device tree overlays in the Linux kernel.

set -e

if [ -z "$VENDOR" ]; then
	if [ ! -e /sys/class/dmi/id/board_vendor ]; then
		echo "No vendor found!" >&2
		exit 1
	fi
	VENDOR=$(tr -d '\0' < /sys/class/dmi/id/board_vendor)
fi


if [ -z "$BOARD" ]; then
	if [ ! -e /sys/class/dmi/id/board_name ]; then
		echo "No board name found!" >&2
		exit 1
	fi
	BOARD=$(tr -d '\0' < /sys/class/dmi/id/board_name)
fi

# LDTO_SYSROOT prefixes every system path (tests run the whole lifecycle in a
# scratch tree); LDTO_EFI_DTB names the ESP dtb/ directory directly.
LDTO_SYSROOT=${LDTO_SYSROOT:-}
PATH_OF_CONFIG=$LDTO_SYSROOT/sys/kernel/config/device-tree/overlays
PATH_OF_DT=$LDTO_SYSROOT/sys/firmware/fdt
PATH_OF_PROC_DT=$LDTO_SYSROOT/proc/device-tree
PATH_OF_RUN=$LDTO_SYSROOT/run/ldto
PATH_OF_BOOT_ID=$LDTO_SYSROOT/proc/sys/kernel/random/boot_id
PATH_OF_DEBUG_PINCTRL=$LDTO_SYSROOT/sys/kernel/debug/pinctrl
PATH_OF_PLATFORM_DEVICES=$LDTO_SYSROOT/sys/bus/platform/devices
PATH_OF_DTB_OVERRIDE=
PATH_OF_EFI_DTB=

cd $(dirname $(readlink -f "${BASH_SOURCE[0]}"))

PATH_DTBO=$VENDOR/$BOARD/dt
PATH_DTCFG=$VENDOR/$BOARD/dt.config
MAP_FILE="$VENDOR/$BOARD/dt.map"
DEPS_FILE="$VENDOR/$BOARD/dt.deps"
TAB_CHAR='	'
declare -A MAP_DT_ALIAS
declare -A MAP_ALIAS_DT
declare -A MAP_DEPS

LDTO_loadMap()
{
	if [ -e "$MAP_FILE" ]; then
		while IFS= read -r mapping; do
			[ -z "$mapping" ] && continue
			[[ "$mapping" =~ ^# ]] && continue
			local dt_alias=${mapping%%$TAB_CHAR*}
			local dt_file=${mapping##*$TAB_CHAR}
			# skip non-TSV / empty keys (bash: bad array subscript)
			[ -z "$dt_alias" ] || [ -z "$dt_file" ] && continue
			[ "$dt_alias" = "$mapping" ] && continue
			MAP_DT_ALIAS[$dt_file]="$dt_alias"
			MAP_ALIAS_DT[$dt_alias]="$dt_file"
		done < <(grep -v '^#' "$MAP_FILE" || true)
	fi
}


LDTO_loadDeps()
{
	MAP_DEPS=()
	if [ -e "$DEPS_FILE" ]; then
		while IFS=$'\t' read -r consumer providers || [ -n "$consumer" ]; do
			[ -z "$consumer" ] && continue
			[[ "$consumer" =~ ^# ]] && continue
			MAP_DEPS[$consumer]="$providers"
		done < "$DEPS_FILE"
	fi
}

# Expand args with auto-providers from dt.deps (providers first, no dups).
# A dependency cycle or a chain deeper than LDTO_DEPS_MAX_DEPTH is an error:
# prints WARNING to stderr and returns 1 (callers must check the status;
# capture with out=$(LDTO_expandDeps …) || return 1, not mapfile < <(…)).
LDTO_DEPS_MAX_DEPTH=16
LDTO_expandDeps()
{
	LDTO_loadDeps
	local -a ordered=()
	local -A seen=()
	local -A onpath=()
	local dep_err=""

	_ldto_add() {
		local name="$1"
		local depth="${2:-0}"
		local chain="$3"
		local dep realp
		[ -n "$dep_err" ] && return
		realp=$(LDTO_getAliasDT "$name")
		if [ -n "$realp" ]; then
			name="$realp"
		fi
		chain="${chain:+$chain -> }$name"
		if [[ -v "seen[$name]" ]]; then
			return
		fi
		if [[ -v "onpath[$name]" ]]; then
			dep_err="dependency cycle in $DEPS_FILE: $chain"
			return
		fi
		if [ "$depth" -gt "$LDTO_DEPS_MAX_DEPTH" ]; then
			dep_err="dependency chain deeper than $LDTO_DEPS_MAX_DEPTH in $DEPS_FILE: $chain"
			return
		fi
		onpath[$name]=1
		if [[ -v "MAP_DEPS[$name]" ]]; then
			for dep in ${MAP_DEPS[$name]}; do
				_ldto_add "$dep" $((depth + 1)) "$chain"
			done
		fi
		unset "onpath[$name]"
		if [[ -v "seen[$name]" ]]; then
			return
		fi
		seen[$name]=1
		ordered+=("$name")
	}

	local arg
	for arg in "$@"; do
		_ldto_add "$arg" 0 ""
	done
	if [ -n "$dep_err" ]; then
		echo "WARNING: $dep_err" >&2
		return 1
	fi
	printf '%s\n' "${ordered[@]}"
}

# Order the given overlay names by dt.deps (providers before consumers),
# keeping only the names given (deps that are not in the list are not added).
# Prints one canonical basename per line; returns 1 on a dependency error.
LDTO_orderByDeps()
{
	local -A want=()
	local n out
	for n in "$@"; do
		[ -n "$n" ] && want[$(LDTO_canonName "$n")]=1
	done
	[ ${#want[@]} -gt 0 ] || return 0
	out=$(LDTO_expandDeps "$@") || return 1
	while IFS= read -r n; do
		[ -n "$n" ] && [[ -v "want[$n]" ]] && printf '%s\n' "$n"
	done <<<"$out"
	return 0
}

LDTO_getDTAlias()
{
	if [[ -v "MAP_DT_ALIAS[$1]" ]]; then
		echo "${MAP_DT_ALIAS[$1]}"
	fi
}

LDTO_getAliasDT()
{
	if [[ -v "MAP_ALIAS_DT[$1]" ]]; then
		echo "${MAP_ALIAS_DT[$1]}"
	fi
}

LDTO_getDTBO()
{
	local dtbo_file="$PATH_DTBO/$1.dtbo"
	if [ -f "$dtbo_file" ]; then
		echo "$dtbo_file"
	fi
}

LDTO_getSummary()
{
	# One-line Summary: from .dts header (empty if none)
	local dts="$1"
	[ -f "$dts" ] || return 0
	# POSIX awk (mawk): case-insensitive "Summary:" without IGNORECASE
	LDTO_extractHeaderComments "$dts" 2>/dev/null | awk '
		tolower($0) ~ /^summary:/ {
			sub(/^[^:]*:[[:space:]]*/, "")
			print
			exit
		}
	'
}

LDTO_list()
{
	local dtbos
	dtbos=$(ls "$PATH_DTBO"/*.dtbo 2>/dev/null || true)
	if [ -z "$dtbos" ]; then
		# Allow host-side list from .dts alone
		dtbos=$(ls "$PATH_DTBO"/*.dts 2>/dev/null || true)
		if [ -z "$dtbos" ]; then
			echo "No overlays detected. Did you run make?" >&2
			return 1
		fi
	fi
	LDTO_loadMap
	printf '#%-28s %-24s %s\n' "OVERLAY" "ALIAS" "SUMMARY" >&2
	local i dto alias summary dts
	for i in $dtbos; do
		dto=$(basename "$i")
		dto=${dto%.dtbo}
		dto=${dto%.dts}
		alias=$(LDTO_getDTAlias "$dto")
		dts=$(LDTO_getDTS "$dto")
		summary=""
		if [ -n "$dts" ]; then
			summary=$(LDTO_getSummary "$dts")
		fi
		printf '%-30s %-24s %s\n' "$dto" "${alias:--}" "${summary:--}"
	done
}

LDTO_checkOFConfig()
{
	if [ $# -eq 0 ]; then
		if ! test -r "$PATH_OF_CONFIG"; then
			echo "$FUNCNAME: OF path not readable! sudo?" >&2
			return 1
		fi
	else
		if ! test -w "$PATH_OF_CONFIG"; then
			echo "$FUNCNAME: OF path not writable! sudo?" >&2
			return 1
		fi
	fi
}

# Collect header pins claimed by an overlay (Header\tPin\tName\tSource)
# Source is "header" (Pins: table / pin notes) or "dts" (body pad → gpio.map).
LDTO_collectOverlayPins()
{
	local dto="$1"
	local dts
	dts=$(LDTO_getDTS "$dto")
	[ -n "$dts" ] || return 0
	LDTO_loadGpioMap
	[ -n "$GPIO_MAP_FILE" ] || return 0

	local comments
	comments=$(LDTO_extractHeaderComments "$dts")

	# Structured Pins: 7J1.19  GPIOX_8 ... / J1.18  GPIO3_A5 ...
	# Header names follow gpio.map column 1: optional digit prefix + J + digits
	# (7J1, 2J3, 9J1, J1, J12, ...). The leading class keeps it off the tail
	# of a longer word (e.g. "PJ1.2").
	printf '%s\n' "$comments" | awk -v o="$dto" '
		{
			line = $0
			# strip leading "* " from comment extract if present
			sub(/^[[:space:]]+/, "", line)
			if (match(line, /(^|[^A-Za-z0-9_])[0-9]*[Jj][0-9]+\.[0-9]+[[:space:]]+[A-Za-z0-9_*]+/)) {
				tok = substr(line, RSTART, RLENGTH)
				sub(/^[^0-9Jj]/, "", tok)
				split(tok, a, /[\.[:space:]]+/)
				# a[1]=7J1 a[2]=19 a[3]=GPIOX_8
				if (a[1] != "" && a[2] != "" && a[3] != "")
					print a[1] "\t" a[2] "\t" a[3] "\t" o "\theader"
			}
		}
	'

	# Body pad names → gpio.map
	local name row
	while IFS= read -r name; do
		[ -z "$name" ] && continue
		if row=$(LDTO_gpioLookupName "$name"); then
			while IFS= read -r r; do
				[ -z "$r" ] && continue
				local header pin chip line sysfs gname pad ref desc
				IFS=$'\t' read -r header pin chip line sysfs gname pad ref desc <<<"$r"
				case "$gname" in GND|5V|3.3V) continue ;; esac
				printf '%s\t%s\t%s\t%s\tdts\n' "$header" "$pin" "$gname" "$dto"
			done <<<"$row"
		fi
	done < <(LDTO_extractGpioNames "$dts")
}

LDTO_printPlan()
{
	# $@ = overlay names (already expanded or not)
	LDTO_loadMap
	LDTO_loadGpioMap
	local -a seq
	local seq_out
	seq_out=$(LDTO_expandDeps "$@") || return 1
	mapfile -t seq <<<"$seq_out"
	echo "Plan (dependency order):"
	local dto n=0
	for dto in "${seq[@]}"; do
		local dto_real dtbo summary dts
		dto_real=$(LDTO_getAliasDT "$dto")
		[ -n "$dto_real" ] && dto=$dto_real
		n=$((n + 1))
		dtbo=$(LDTO_getDTBO "$dto")
		dts=$(LDTO_getDTS "$dto")
		summary=""
		[ -n "$dts" ] && summary=$(LDTO_getSummary "$dts")
		local state="apply" st
		if [ -d "$PATH_OF_CONFIG" ] && [ -e "$PATH_OF_CONFIG/$dto" ]; then
			# R9: existence ≠ applied (same rule as enable R1)
			st=$(tr -d '\n' < "$PATH_OF_CONFIG/$dto/status" 2>/dev/null || echo unknown)
			if [ "$st" = "applied" ]; then
				state="already-active"
			else
				state="configfs-$st"
			fi
		elif [ -z "$dtbo" ]; then
			state="MISSING-dtbo"
		fi
		printf '  %2d. %-28s [%s] %s\n' "$n" "$dto" "$state" "${summary:--}"
	done

	echo
	echo "Header pins that would be claimed:"
	printf '  %-6s %-4s %-14s %s\n' "Header" "Pin" "Name" "Overlay"
	local pins_all
	pins_all=$(
		for dto in "${seq[@]}"; do
			dto_real=$(LDTO_getAliasDT "$dto")
			[ -n "$dto_real" ] && dto=$dto_real
			LDTO_collectOverlayPins "$dto"
		done | sort -u
	)
	if [ -z "$pins_all" ]; then
		echo "  (none resolved — bus-only pinctrl or missing .dts/gpio.map)"
	else
		# collapse multi-source rows: Header Pin Name -> overlays
		printf '%s\n' "$pins_all" | awk -F '\t' '
			{
				key = $1 "\t" $2 "\t" $3
				if (!s[key, $4]++) {
					if (o[key] == "") o[key] = $4
					else o[key] = o[key] "," $4
				}
			}
			END {
				for (k in o) {
					split(k, a, "\t")
					printf "%s\t%02d\t%s\t%s\t%s\n", a[1], a[2]+0, a[2], a[3], o[k]
				}
			}
		' | sort -t$'\t' -k1,1 -k2,2n | awk -F '\t' '{
			printf "  %-6s %-4s %-14s %s\n", $1, $3, $4, $5
		}'
	fi
}

# Resolve alias → canonical overlay basename.
LDTO_canonName()
{
	local name="$1" real
	real=$(LDTO_getAliasDT "$name")
	if [ -n "$real" ]; then
		echo "$real"
	else
		echo "$name"
	fi
}

# Reject path metacharacters before joining configfs / dt paths (R16).
LDTO_validOverlayName()
{
	local n="$1"
	case "$n" in
		""|*/*|*\\*|*".."*|.*)
			return 1
			;;
	esac
	return 0
}

# Validate one or more user overlay args; print WARNING and return 1 on bad name.
LDTO_requireValidNames()
{
	local a
	for a in "$@"; do
		if ! LDTO_validOverlayName "$a"; then
			echo "WARNING: invalid overlay name '$a' (no path components or empty)" >&2
			return 1
		fi
	done
	return 0
}

# Dep-expand + canonicalize. Prints one basename per line (providers first).
LDTO_planSequence()
{
	LDTO_loadMap
	local -a seq
	local seq_out
	seq_out=$(LDTO_expandDeps "$@") || return 1
	mapfile -t seq <<<"$seq_out"
	local dto
	for dto in "${seq[@]}"; do
		LDTO_canonName "$dto"
	done
}

# Apply overlay chain to a private temp tree; never touches ESP/configfs.
# On intermediate failure: WARNING naming the failing step, plan, and prior
# steps that would have applied (autoload chain). ESP left unchanged.
# Usage: LDTO_chainPreflight <base.dtb> <out.dtb> name1 [name2...]
# Returns 0 and writes out.dtb on full success; 1 on failure (out removed).
LDTO_chainPreflight()
{
	local base_dtb="$1"
	local out_dtb="$2"
	shift 2
	local -a chain=("$@")

	if [ ! -f "$base_dtb" ]; then
		echo "WARNING: chain preflight: base DTB not found: $base_dtb" >&2
		return 1
	fi
	if [ ${#chain[@]} -eq 0 ]; then
		cp -f "$base_dtb" "$out_dtb"
		return 0
	fi
	if ! command -v fdtoverlay >/dev/null 2>&1; then
		echo "WARNING: fdtoverlay not found (install device-tree-compiler)" >&2
		return 1
	fi

	local tmpdir current next i dto dtbo_file err
	local -a applied=()
	tmpdir=$(mktemp -d /tmp/ldto-preflight.XXXXXX) || return 1
	current="$base_dtb"
	i=0

	for dto in "${chain[@]}"; do
		dtbo_file=$(LDTO_getDTBO "$dto")
		if [ -z "$dtbo_file" ] || [ ! -f "$dtbo_file" ]; then
			echo "WARNING: apply not clean — missing .dtbo for '$dto' (step $((i + 1))/${#chain[@]})" >&2
			echo "WARNING: autoload plan: ${chain[*]}" >&2
			if [ ${#applied[@]} -gt 0 ]; then
				echo "WARNING: would have applied before failure: ${applied[*]}" >&2
			fi
			echo "WARNING: run: make BOARD_NAME=$BOARD" >&2
			rm -rf "$tmpdir"
			rm -f "$out_dtb"
			return 1
		fi
		next="$tmpdir/step-$i.dtb"
		err=$(fdtoverlay -i "$current" -o "$next" "$dtbo_file" 2>&1) || {
			echo "WARNING: apply not clean at overlay '$dto' (step $((i + 1))/${#chain[@]})" >&2
			echo "WARNING: autoload plan: ${chain[*]}" >&2
			if [ ${#applied[@]} -gt 0 ]; then
				echo "WARNING: intermediaries OK before failure: ${applied[*]}" >&2
			else
				echo "WARNING: failed on first overlay in chain (no intermediaries applied)" >&2
			fi
			echo "WARNING: fdtoverlay: ${err:-exit $?}" >&2
			rm -rf "$tmpdir"
			rm -f "$out_dtb"
			return 1
		}
		applied+=("$dto")
		current="$next"
		i=$((i + 1))
	done

	cp -f "$current" "$out_dtb"
	rm -rf "$tmpdir"
	return 0
}

# Rollback configfs overlays created in this enable invocation (best-effort).
# Reverse (LIFO) order so consumers are removed before providers.
LDTO_rollbackConfigFS()
{
	local -a items=("$@")
	local i dto
	for ((i=${#items[@]}-1; i>=0; i--)); do
		dto="${items[i]}"
		if [ -e "$PATH_OF_CONFIG/$dto" ]; then
			rmdir "$PATH_OF_CONFIG/$dto" 2>/dev/null || true
			echo "Overlay $dto: rolled back" >&2
		fi
	done
}

# Basenames of configfs overlays with status "applied" (one per line).
LDTO_listAppliedOverlays()
{
	local d st
	[ -d "$PATH_OF_CONFIG" ] || return 0
	for d in "$PATH_OF_CONFIG"/*; do
		[ -e "$d" ] || continue
		st=$(tr -d '\n' < "$d/status" 2>/dev/null || echo unknown)
		[ "$st" = "applied" ] || continue
		basename "$d"
	done
}

# Plan steps that still need configfs apply (not already status=applied).
# Prints one basename per line.
LDTO_planToApply()
{
	local dto st
	for dto in "$@"; do
		if [ -d "$PATH_OF_CONFIG" ] && [ -e "$PATH_OF_CONFIG/$dto" ]; then
			st=$(tr -d '\n' < "$PATH_OF_CONFIG/$dto/status" 2>/dev/null || echo unknown)
			if [ "$st" = "applied" ]; then
				continue
			fi
		fi
		printf '%s\n' "$dto"
	done
}

# Write live-ish base DTB to $1: stock firmware FDT + currently applied
# overlays that have a local .dtbo, re-applied in dt.deps order (providers
# first; configfs readdir order is alphabetical, not apply order).
# Returns 0 on success; 1 if firmware unreadable or active re-apply fails.
LDTO_buildLiveBase()
{
	local out="$1"
	local name dtbo applied_out
	local -a applied=() chain=()

	if [ ! -r "$PATH_OF_DT" ]; then
		return 1
	fi

	applied_out=$(LDTO_listAppliedOverlays)
	if [ -n "$applied_out" ]; then
		mapfile -t applied <<<"$applied_out"
		applied_out=$(LDTO_orderByDeps "${applied[@]}") || return 1
		mapfile -t applied <<<"$applied_out"
	fi
	for name in "${applied[@]}"; do
		[ -n "$name" ] || continue
		dtbo=$(LDTO_getDTBO "$name")
		if [ -n "$dtbo" ] && [ -f "$dtbo" ]; then
			chain+=("$name")
		else
			echo "WARNING: live preflight: active overlay '$name' has no local .dtbo; live base may be incomplete" >&2
		fi
	done

	if [ ${#chain[@]} -eq 0 ]; then
		cp -f "$PATH_OF_DT" "$out"
		return 0
	fi
	# Re-apply actives onto stock firmware; failure means we cannot model live OF.
	if ! LDTO_chainPreflight "$PATH_OF_DT" "$out" "${chain[@]}"; then
		echo "WARNING: live preflight: cannot reconstruct base from actives: ${chain[*]}" >&2
		return 1
	fi
	return 0
}

# R2(c): hard-fail enable when plan collides on pins with actives / itself.
# Uses LDTO_conflicts (deps + configfs actives). Output only on failure.
LDTO_enableGateConflicts()
{
	local out rc=0
	out=$(mktemp /tmp/ldto-conflicts.XXXXXX) || return 1
	LDTO_conflicts "$@" >"$out" 2>&1 || rc=$?
	if [ "$rc" -eq 2 ]; then
		echo "WARNING: pin or resource conflicts between plan and/or active overlays" >&2
		cat "$out" >&2
		rm -f "$out"
		return 1
	fi
	if [ "$rc" -ne 0 ]; then
		echo "WARNING: conflict check failed (exit $rc)" >&2
		cat "$out" >&2
		rm -f "$out"
		return 1
	fi
	rm -f "$out"
	return 0
}

# R2(b): fdtoverlay plan steps that are not already applied, against
# firmware FDT + re-applied current actives (not stock FDT alone).
# Usage: LDTO_enableLivePreflight name1 [name2...]   (canonical plan seq)
LDTO_enableLivePreflight()
{
	local -a seq=("$@")
	local -a to_apply=()
	local live out

	if [ ! -r "$PATH_OF_DT" ]; then
		# Dry-run reports SKIPPED before calling here; a real apply without
		# the chain check is opt-in only (--no-preflight).
		echo "WARNING: enable aborted — cannot live-preflight (no readable $PATH_OF_DT); nothing applied" >&2
		echo "WARNING: re-run with --no-preflight to apply without the conflict and chain checks" >&2
		return 1
	fi

	mapfile -t to_apply < <(LDTO_planToApply "${seq[@]}")
	# Drop empty last line from mapfile on empty input
	if [ ${#to_apply[@]} -eq 1 ] && [ -z "${to_apply[0]}" ]; then
		to_apply=()
	fi

	live=$(mktemp /tmp/ldto-live.XXXXXX.dtb) || return 1
	out=$(mktemp /tmp/ldto-enable.XXXXXX.dtb) || {
		rm -f "$live"
		return 1
	}

	if ! LDTO_buildLiveBase "$live"; then
		rm -f "$live" "$out"
		echo "WARNING: enable aborted — cannot build live preflight base (firmware + actives)" >&2
		return 1
	fi

	if [ ${#to_apply[@]} -eq 0 ]; then
		echo "Preflight: all planned overlays already applied (live base OK)" >&2
		rm -f "$live" "$out"
		return 0
	fi

	if ! LDTO_chainPreflight "$live" "$out" "${to_apply[@]}"; then
		rm -f "$live" "$out"
		echo "WARNING: enable aborted — chain does not apply cleanly to live tree (firmware + actives)" >&2
		echo "WARNING: new steps: ${to_apply[*]}" >&2
		return 1
	fi
	rm -f "$live" "$out"
	return 0
}

LDTO_enable()
{
	local dry_run=0
	local skip_preflight=0
	local -a args=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run|-n)
				dry_run=1
				shift
				;;
			--no-preflight)
				skip_preflight=1
				shift
				;;
			--help|-h)
				echo "$0 enable [--dry-run|-n] [--no-preflight] OVERLAY [OVERLAY...]" >&2
				echo "  Auto-applies providers from dt.deps (autoload chain)." >&2
				echo "  Before configfs: (1) pin conflicts vs actives, (2) fdtoverlay of" >&2
				echo "  new steps on live base = firmware FDT + currently applied overlays." >&2
				echo "  Intermediate failure → WARNING, applies nothing." >&2
				echo "  --dry-run: plan + same gates, no configfs. --no-preflight: skip both gates." >&2
				return 0
				;;
			--)
				shift
				args+=("$@")
				break
				;;
			-*)
				echo "$FUNCNAME: unknown option $1" >&2
				return 1
				;;
			*)
				args+=("$1")
				shift
				;;
		esac
	done

	if [ ${#args[@]} -eq 0 ]; then
		LDTO_list
		return 1
	fi

	if ! LDTO_requireValidNames "${args[@]}"; then
		return 1
	fi

	# Runtime overlays act on this boot's DT; say so when the next boot will
	# load a different one (reset or merge not yet rebooted).
	LDTO_warnNextBoot

	if [ "$dry_run" -eq 1 ]; then
		echo "DRY-RUN: no configfs changes" >&2
		LDTO_printPlan "${args[@]}" || return 1
		LDTO_loadMap
		local -a seq
		local seq_out
		seq_out=$(LDTO_planSequence "${args[@]}") || return 1
		mapfile -t seq <<<"$seq_out"
		# Fail dry-run if any plan step lacks a .dtbo (same as real enable)
		local dto dtbo_file missing=0
		for dto in "${seq[@]}"; do
			dtbo_file=$(LDTO_getDTBO "$dto")
			if [ -z "$dtbo_file" ]; then
				echo "WARNING: dry-run: missing .dtbo for '$dto'" >&2
				missing=1
			fi
		done
		if [ "$missing" -eq 1 ]; then
			echo "WARNING: dry-run aborted — plan has missing .dtbo" >&2
			return 1
		fi
		if [ "$skip_preflight" -eq 0 ]; then
			if ! LDTO_enableGateConflicts "${args[@]}"; then
				return 1
			fi
			echo "DRY-RUN: pin/resource conflicts OK" >&2
			# R10: do not claim OK when firmware FDT is missing (soft-skip).
			if [ ! -r "$PATH_OF_DT" ]; then
				echo "DRY-RUN: live fdtoverlay preflight SKIPPED (no readable $PATH_OF_DT)" >&2
			elif ! LDTO_enableLivePreflight "${seq[@]}"; then
				return 1
			else
				echo "DRY-RUN: live fdtoverlay preflight OK" >&2
			fi
		fi
		return 0
	fi

	LDTO_checkOFConfig RW
	LDTO_loadMap
	local -a seq
	local seq_out
	seq_out=$(LDTO_planSequence "${args[@]}") || return 1
	mapfile -t seq <<<"$seq_out"

	# Resolve .dtbo for every step before touching configfs
	local dto dtbo_file
	for dto in "${seq[@]}"; do
		dtbo_file=$(LDTO_getDTBO "$dto")
		if [ -z "$dtbo_file" ]; then
			echo "WARNING: apply not clean — missing .dtbo for '$dto'" >&2
			echo "WARNING: autoload plan: ${seq[*]}" >&2
			return 1
		fi
	done

	# R2: conflicts (c) then live-base chain preflight (b). Zero configfs on fail.
	if [ "$skip_preflight" -eq 0 ]; then
		if ! LDTO_enableGateConflicts "${args[@]}"; then
			return 1
		fi
		if ! LDTO_enableLivePreflight "${seq[@]}"; then
			return 1
		fi
	fi

	local -a applied_now=()
	local status
	for dto in "${seq[@]}"; do
		dtbo_file=$(LDTO_getDTBO "$dto")
		# Exists ≠ applied: only skip when configfs status is applied.
		# Leftover dirs after a failed apply are usually unapplied and must
		# be rmdir'd so re-enable can mkdir + write again.
		if [ -e "$PATH_OF_CONFIG/$dto" ]; then
			status=$(tr -d '\n' < "$PATH_OF_CONFIG/$dto/status" 2>/dev/null || echo unknown)
			if [ "$status" = "applied" ]; then
				echo "Overlay $dto: already active" >&2
				continue
			fi
			echo "Overlay $dto: configfs present but status='$status'; removing and re-applying" >&2
			if ! rmdir "$PATH_OF_CONFIG/$dto" 2>/dev/null; then
				echo "WARNING: apply not clean — cannot remove stale configfs node for '$dto' (status=$status)" >&2
				echo "WARNING: autoload plan: ${seq[*]}" >&2
				if [ ${#applied_now[@]} -gt 0 ]; then
					echo "WARNING: rolling back overlays applied in this command: ${applied_now[*]}" >&2
					LDTO_rollbackConfigFS "${applied_now[@]}"
				fi
				return 1
			fi
		fi
		if ! mkdir "$PATH_OF_CONFIG/$dto" 2>/dev/null; then
			echo "WARNING: apply not clean — cannot create configfs node for '$dto'" >&2
			echo "WARNING: autoload plan: ${seq[*]}" >&2
			if [ ${#applied_now[@]} -gt 0 ]; then
				echo "WARNING: rolling back overlays applied in this command: ${applied_now[*]}" >&2
				LDTO_rollbackConfigFS "${applied_now[@]}"
			fi
			return 1
		fi
		if ! cat "$dtbo_file" > "$PATH_OF_CONFIG/$dto/dtbo" 2>/dev/null; then
			echo "WARNING: apply not clean — failed writing dtbo for '$dto'" >&2
			rmdir "$PATH_OF_CONFIG/$dto" 2>/dev/null || true
			if [ ${#applied_now[@]} -gt 0 ]; then
				echo "WARNING: rolling back: ${applied_now[*]}" >&2
				LDTO_rollbackConfigFS "${applied_now[@]}"
			fi
			return 1
		fi
		# Kernel configfs status is only "applied" or "unapplied" (of/configfs.c).
		status=$(tr -d '\n' < "$PATH_OF_CONFIG/$dto/status" 2>/dev/null || echo unknown)
		echo "Overlay $dto: $status" >&2
		if [ "$status" = "applied" ]; then
			applied_now+=("$dto")
		else
			echo "WARNING: apply not clean — configfs status for '$dto' is '$status'" >&2
			echo "WARNING: autoload plan: ${seq[*]}" >&2
			if [ ${#applied_now[@]} -gt 0 ]; then
				echo "WARNING: intermediaries applied before failure: ${applied_now[*]}" >&2
				echo "WARNING: rolling back this command's overlays (not pre-existing ones)" >&2
				LDTO_rollbackConfigFS "${applied_now[@]}"
			fi
			rmdir "$PATH_OF_CONFIG/$dto" 2>/dev/null || true
			return 1
		fi
	done
}

LDTO_disable()
{
	if [ -z "$1" ]; then
		LDTO_active
		return 1
	fi
	if ! LDTO_requireValidNames "$@"; then
		return 1
	fi
	LDTO_checkOFConfig RW
	LDTO_loadMap

	# Resolve aliases, then remove in reverse plan order (consumers before
	# providers) so bus is not yanked under an active device (R8 / R3 mirror).
	local -a resolved=()
	local dto dto_real
	for dto in "$@"; do
		dto_real=$(LDTO_getAliasDT "$dto")
		if [ -n "$dto_real" ]; then
			resolved+=("$dto_real")
		else
			resolved+=("$dto")
		fi
	done

	local -a seq=()
	local -a to_remove=()
	local i s seq_out
	seq_out=$(LDTO_planSequence "${resolved[@]}") || return 1
	mapfile -t seq <<<"$seq_out"
	# Reverse of providers-first plan ⇒ consumers first
	for ((i=${#seq[@]}-1; i>=0; i--)); do
		s="${seq[i]}"
		# Only remove names the user asked for (or their aliases), not pure deps
		for dto in "${resolved[@]}"; do
			if [ "$dto" = "$s" ]; then
				to_remove+=("$s")
				break
			fi
		done
	done
	# Fallback: if planSequence filtered oddly, reverse resolved as-is
	if [ ${#to_remove[@]} -eq 0 ]; then
		for ((i=${#resolved[@]}-1; i>=0; i--)); do
			to_remove+=("${resolved[i]}")
		done
	fi

	for dto in "${to_remove[@]}"; do
		if [ ! -e "$PATH_OF_CONFIG/$dto" ]; then
			echo "Overlay $dto: does not exist and cannot be removed" >&2
			return 1
		fi
		if ! rmdir "$PATH_OF_CONFIG/$dto" 2>/dev/null; then
			echo "WARNING: Overlay $dto: remove failed (still in use or kernel rejected rmdir?)" >&2
			return 1
		fi
		echo "Overlay $dto: removed" >&2
	done
}

LDTO_status()
{
	# R9: only status=applied (not leftover unapplied dirs)
	echo "#Overlays active (status=applied):" >&2
	local i st merged
	if [ -d "$PATH_OF_CONFIG" ]; then
		for i in "$PATH_OF_CONFIG"/*; do
			[ -e "$i" ] || continue
			st=$(tr -d '\n' < "$i/status" 2>/dev/null || echo unknown)
			[ "$st" = "applied" ] || continue
			basename "$i"
		done
	fi
	merged=$(LDTO_bootedChosen "$LDTO_PROP_MERGED")
	echo "#Merged into this boot's DT: ${merged:-none recorded}" >&2
	LDTO_nextBootState
	echo "#Next boot DT: $LDTO_STATE" >&2
	if [ -n "$LDTO_STATE_MSG" ]; then
		echo "WARNING: $LDTO_STATE_MSG" >&2
	fi
	if [ -n "$LDTO_STATE_NOTE" ]; then
		echo "WARNING: $LDTO_STATE_NOTE" >&2
	fi
	return 0
}

LDTO_active()
{
	LDTO_checkOFConfig
	if [ -z "$1" ]; then
		LDTO_status
	else
		# Configfs node names are canonical basenames; resolve dt.map aliases
		# so `active H40P_…` matches the applied overlay name. All args must
		# be applied (R14 multi-query).
		if ! LDTO_requireValidNames "$@"; then
			return 1
		fi
		LDTO_loadMap
		local query dto_real i found st
		for query in "$@"; do
			dto_real=$(LDTO_getAliasDT "$query")
			if [ -n "$dto_real" ]; then
				query="$dto_real"
			fi
			found=0
			for i in "$PATH_OF_CONFIG"/*; do
				[ -e "$i" ] || continue
				if [ "$query" = "$(basename "$i")" ]; then
					st=$(tr -d '\n' < "$i/status" 2>/dev/null || echo unknown)
					if [ "$st" = "applied" ]; then
						found=1
						break
					fi
				fi
			done
			if [ "$found" -eq 0 ]; then
				return 1
			fi
		done
		return 0
	fi
}

LDTO_importDTConfig()
{
	if [ -f "$PATH_DTCFG" ]; then
		. "$PATH_DTCFG"
	else
		echo "$FUNCNAME: board device tree configuration cannot be found." >&2
		return 1
	fi
}

LDTO_checkFirmwareDT()
{
	if [ ! -e "$PATH_OF_DT" ]; then
		echo "$FUNCNAME: system device tree cannot be found." >&2
		return 1
	fi
	if ! test -r "$PATH_OF_DT"; then
		echo "$FUNCNAME: system device tree cannot be read! sudo?" >&2
		return 1
	fi
}

LDTO_findEFIDTBPath()
{
	if [ -n "${LDTO_EFI_DTB:-}" ]; then
		PATH_OF_EFI_DTB=$LDTO_EFI_DTB
		[ $# -ne 0 ] && mkdir -p "$PATH_OF_EFI_DTB"
		return 0
	fi
	# Empty when nothing is mounted under /boot; the NFS-root branch below
	# still applies then.
	local mnt_boot=$(cut -f 2 -d " " /proc/mounts  | grep ^/boot)
	for mnt_dir in $mnt_boot; do
		if [ -d "$mnt_dir"/EFI/BOOT -o -e "$mnt_dir"/uboot.env ]; then
			PATH_OF_EFI_DTB="$mnt_dir"/dtb
			if [ $# -ne 0 ]; then
				if [ -d "$PATH_OF_EFI_DTB" ]; then
					if ! test -w "$PATH_OF_EFI_DTB"; then
						echo "$FUNCNAME: EFI path not writable! sudo?" >&2
						return 1
					fi
				else
					if ! test -w "$mnt_dir"; then
						echo "$FUNCNAME: EFI path not writable! sudo?" >&2
						return 1
					fi
					if [ ! -d "$PATH_OF_EFI_DTB" ]; then
						mkdir -p "$PATH_OF_EFI_DTB"
					fi
				fi
			fi
			return
		fi
	done
	if grep "root=/dev/nfs" /proc/cmdline > /dev/null; then
		# Same RW gate as the non-NFS EFI branch: mkdir only when a
		# non-empty arg requests write (e.g. merge install). Dry-run
		# and read-only lookups must not create /boot/efi/dtb.
		PATH_OF_EFI_DTB=/boot/efi/dtb
		if [ $# -ne 0 ]; then
			if [ -d "$PATH_OF_EFI_DTB" ]; then
				if ! test -w "$PATH_OF_EFI_DTB"; then
					echo "$FUNCNAME: EFI path not writable! sudo?" >&2
					return 1
				fi
			else
				if ! test -w /boot/efi; then
					echo "$FUNCNAME: EFI path not writable! sudo?" >&2
					return 1
				fi
				mkdir -p "$PATH_OF_EFI_DTB"
			fi
		fi
		return
	fi
	echo "$FUNCNAME: no EFI boot path found." >&2
	return 1
}

# --------------------------------------------------------------------------
# Merge record and next-boot state.
#
# Boot DT priority: the ESP override DTB if present, else U-Boot's built-in
# DT. ldto stamps every override it writes with /chosen properties; U-Boot
# (fdt_chosen) and the EFI stub keep unknown /chosen properties, so the
# running kernel shows the stamp of the DT it booted in /proc/device-tree.
# Comparing that with the override file says whether the next boot will use
# a different DT than this one -- without knowing which command changed it.
LDTO_PROP_ID=libretech,ldto-id          # sha256 of the DTB (as DTS) minus this prop
LDTO_PROP_MERGED=libretech,ldto-merged  # overlays merged, in apply order
LDTO_PROP_BASE=libretech,ldto-base      # builtin:<u-boot,version> | override:<id> | override-unstamped | override-modified
LDTO_PROP_EDITED=libretech,ldto-edited  # present after `ldto edit`: record is advisory
LDTO_PROP_UBOOT=libretech,ldto-u-boot   # u-boot,version whose built-in DT the override started from
# Per-boot values the bootloader and EFI stub write into /chosen; merged
# onto /sys/firmware/fdt they would be frozen into the override.
LDTO_VOLATILE_CHOSEN=(kaslr-seed rng-seed linux,initrd-start linux,initrd-end
	u-boot,version linux,uefi-system-table linux,uefi-mmap-start
	linux,uefi-mmap-size linux,uefi-mmap-desc-size linux,uefi-mmap-desc-ver
	linux,uefi-secure-boot linux,elfcorehdr linux,usable-memory-range
	linux,booted-from-kexec linux,ima-kexec-buffer linux,tpm-kexec-buffer)

# Stamp of a DTB file: sha256 of its decompiled tree without the stamp
# property. Decompiled, because fdtput -d leaves the deleted name in the
# strings block, so raw bytes would differ after the first stamp.
LDTO_dtbComputeId()
{
	local t
	t=$(mktemp /tmp/ldto-id.XXXXXX.dtb) || return 1
	cp -f "$1" "$t" || { rm -f "$t"; return 1; }
	fdtput -d "$t" /chosen "$LDTO_PROP_ID" 2>/dev/null || true
	dtc -q -I dtb -O dts "$t" 2>/dev/null | sha256sum | cut -c1-64
	rm -f "$t"
}

# /chosen property of a DTB file as space-separated words ("" if absent).
LDTO_dtbChosen()
{
	fdtget -ts "$1" /chosen "$2" 2>/dev/null || true
}

# /chosen property of the DT this system booted ("" if absent).
LDTO_bootedChosen()
{
	local f="$PATH_OF_PROC_DT/chosen/$1"
	[ -f "$f" ] || return 0
	tr '\0' ' ' < "$f" | sed 's/ *$//'
}

# Write the record into DTB $1: base kind $2, edited flag $3 (0/1), the
# U-Boot version of the built-in base $4 ("" = unknown), then the merged
# overlay names; the stamp goes last, over everything else.
LDTO_stampDTB()
{
	local f="$1" base="$2" edited="$3" uboot="$4" id
	shift 4
	fdtput -p -ts "$f" /chosen "$LDTO_PROP_BASE" "$base" || return 1
	if [ -n "$uboot" ]; then
		fdtput -p -ts "$f" /chosen "$LDTO_PROP_UBOOT" "$uboot" || return 1
	else
		fdtput -d "$f" /chosen "$LDTO_PROP_UBOOT" 2>/dev/null || true
	fi
	if [ $# -gt 0 ]; then
		fdtput -p -ts "$f" /chosen "$LDTO_PROP_MERGED" "$@" || return 1
	else
		fdtput -d "$f" /chosen "$LDTO_PROP_MERGED" 2>/dev/null || true
	fi
	if [ "$edited" = "1" ]; then
		fdtput -p -ts "$f" /chosen "$LDTO_PROP_EDITED" "1" || return 1
	else
		fdtput -d "$f" /chosen "$LDTO_PROP_EDITED" 2>/dev/null || true
	fi
	id=$(LDTO_dtbComputeId "$f") || return 1
	[ -n "$id" ] || return 1
	fdtput -p -ts "$f" /chosen "$LDTO_PROP_ID" "$id"
}

LDTO_bootId()
{
	if [ -r "$PATH_OF_BOOT_ID" ]; then
		tr -d '\n' < "$PATH_OF_BOOT_ID"
	fi
	return 0
}

# Fallback for overrides with no stamp (written by an older ldto or another
# tool): `ldto reset` leaves this marker for the rest of the boot.
LDTO_resetMarkerValid()
{
	local m="$PATH_OF_RUN/reset-pending" b
	[ -f "$m" ] || return 1
	b=$(LDTO_bootId)
	[ -n "$b" ] && [ "$(sed -n 's/^boot_id=//p' "$m")" = "$b" ]
}

# Sets LDTO_STATE and LDTO_STATE_MSG, comparing the DT this system booted
# with the one the next boot loads (override file, else U-Boot built-in):
#   unknown        no booted DT here (host) or no ESP: nothing to compare
#   builtin        booted and next boot both use the built-in DT
#   sync           next boot loads the same override this boot used
#   removed        this boot used an override that is gone (reset or deleted)
#   changed        override merged/edited since boot
#   pending-merge  override written since boot; this boot did not use one
#   replaced       override overwritten by another tool: merged overlays lost
#   tampered       override changed outside ldto: its record is advisory
#   legacy         override without an ldto record: cannot compare
LDTO_nextBootState()
{
	LDTO_STATE=unknown
	LDTO_STATE_MSG=
	LDTO_STATE_NOTE=
	[ -d "$PATH_OF_PROC_DT" ] || return 0
	LDTO_importDTConfig 2>/dev/null || return 0
	LDTO_findEFIDTBPath 2>/dev/null || return 0
	local file="$PATH_OF_EFI_DTB/$DT_OVERRIDE"
	local b f= c= blist flist
	b=$(LDTO_bootedChosen "$LDTO_PROP_ID")
	blist=$(LDTO_bootedChosen "$LDTO_PROP_MERGED")
	if [ -f "$file" ]; then
		f=$(LDTO_dtbChosen "$file" "$LDTO_PROP_ID")
		flist=$(LDTO_dtbChosen "$file" "$LDTO_PROP_MERGED")
		[ -n "$f" ] && c=$(LDTO_dtbComputeId "$file")
	fi
	if [ -n "$b" ]; then
		if [ ! -f "$file" ]; then
			LDTO_STATE=removed
		elif [ -z "$f" ]; then
			LDTO_STATE=replaced
		elif [ "$c" != "$f" ]; then
			LDTO_STATE=tampered
		elif [ "$f" != "$b" ]; then
			LDTO_STATE=changed
		else
			LDTO_STATE=sync
		fi
	else
		if [ ! -f "$file" ]; then
			if LDTO_resetMarkerValid; then
				LDTO_STATE=removed
			else
				LDTO_STATE=builtin
			fi
		elif [ -z "$f" ]; then
			LDTO_STATE=legacy
		elif [ "$c" != "$f" ]; then
			LDTO_STATE=tampered
		else
			LDTO_STATE=pending-merge
		fi
	fi
	case "$LDTO_STATE" in
	removed)
		LDTO_STATE_MSG="the next boot uses U-Boot's built-in DT, but this boot is still running the override that was removed${blist:+ (merged: $blist)} -- reboot to apply" ;;
	changed)
		LDTO_STATE_MSG="the override was changed after this boot${flist:+ (now merged: $flist)} -- reboot to apply" ;;
	pending-merge)
		LDTO_STATE_MSG="the override was written after this boot${flist:+ (merged: $flist)} -- reboot to apply" ;;
	replaced)
		LDTO_STATE_MSG="$file was overwritten by another tool; the overlays merged in this boot's DT are not in it${blist:+: $blist} -- merge them again if still wanted" ;;
	tampered)
		LDTO_STATE_MSG="$file was modified outside ldto; its merged-overlay record is advisory" ;;
	esac
	# The override shadows U-Boot's built-in DT; say so when U-Boot (and with
	# it the built-in DT) is not the one the override was built from.
	local fu bu
	if [ -f "$file" ]; then
		fu=$(LDTO_dtbChosen "$file" "$LDTO_PROP_UBOOT")
		bu=$(LDTO_bootedChosen u-boot,version)
		if [ -n "$fu" ] && [ -n "$bu" ] && [ "$fu" != "$bu" ]; then
			LDTO_STATE_NOTE="U-Boot is now $bu but this override was built on the built-in DT of $fu; it still shadows the newer built-in DT -- reset, reboot and merge again to pick it up"
		fi
	fi
	return 0
}

# One WARNING line when the next boot will not match this one.
LDTO_warnNextBoot()
{
	LDTO_nextBootState
	[ -n "$LDTO_STATE_MSG" ] && echo "WARNING: $LDTO_STATE_MSG" >&2
	[ -n "$LDTO_STATE_NOTE" ] && echo "WARNING: $LDTO_STATE_NOTE" >&2
	return 0
}

# --------------------------------------------------------------------------
# After-check: what a merge does to the tree, read from the DTBs themselves.
#
# Flatten a DTB: "N<TAB>path" per node, "P<TAB>path<TAB>prop<TAB>value" per
# property, from dtc's decompile (one property per line, phandles as cells).
LDTO_dtbFlat()
{
	dtc -q -I dtb -O dts "$1" 2>/dev/null | awk '
	/^[ \t]*\/dts-v1\/;/ || /^[ \t]*\/memreserve\// { next }
	/^[ \t]*\/ \{[ \t]*$/ { depth = 0; path[0] = "/"; print "N\t/"; next }
	/\{[ \t]*$/ {
		name = $0
		sub(/^[ \t]+/, "", name); sub(/[ \t]*\{[ \t]*$/, "", name)
		p = (path[depth] == "/") ? "/" name : path[depth] "/" name
		path[++depth] = p
		print "N\t" p
		next
	}
	/^[ \t]*\};[ \t]*$/ { depth--; next }
	/;[ \t]*$/ {
		line = $0
		sub(/^[ \t]+/, "", line); sub(/;[ \t]*$/, "", line)
		eq = index(line, " = ")
		if (eq) print "P\t" path[depth] "\t" substr(line, 1, eq - 1) "\t" substr(line, eq + 3)
		else print "P\t" path[depth] "\t" line "\t"
	}'
}

# The pads behind pinctrl groups, from the running kernel's pinctrl debugfs
# (mounted, readable: root). Per controller, keyed by its DT path through the
# platform device's of_node: "X<TAB>G<TAB>ctrl<TAB>group<TAB>pad" for each
# pin of each registered group, "X<TAB>Q<TAB>ctrl<TAB>number<TAB>pad" for
# each pin. Prints nothing when debugfs is not there.
LDTO_pinctrlIndex()
{
	local d n dev desc of
	local -a descs=()
	[ -r "$PATH_OF_DEBUG_PINCTRL/pinctrl-devices" ] || return 0
	while read -r desc _; do
		[ "$desc" = "name" ] || descs+=("$desc")
	done < "$PATH_OF_DEBUG_PINCTRL/pinctrl-devices"
	for d in "$PATH_OF_DEBUG_PINCTRL"/*/; do
		[ -r "$d/pingroups" ] && [ -r "$d/pins" ] || continue
		n=${d%/}
		n=${n##*/}
		dev=$n
		# The directory is "<device>-<pinctrl desc name>" unless they match.
		for desc in "${descs[@]}"; do
			if [ "${n%-"$desc"}" != "$n" ]; then
				dev=${n%-"$desc"}
				break
			fi
		done
		of=$(readlink "$PATH_OF_PLATFORM_DEVICES/$dev/of_node" 2>/dev/null) || continue
		case "$of" in
			*devicetree/base*) of=${of#*devicetree/base} ;;
			*) continue ;;
		esac
		[ -n "$of" ] || of=/
		awk -v c="$of" '
		function pad(s) { sub(/^[^(]*\(/, "", s); sub(/\).*$/, "", s); return s }
		/^group: / { g = substr($0, 8); next }
		/^pin [0-9]+ \(/ && g != "" { print "X\tG\t" c "\t" g "\t" pad($0) }' "$d/pingroups"
		awk -v c="$of" '
		/^pin [0-9]+ \(/ { s = $0; sub(/^[^(]*\(/, "", s); sub(/\).*$/, "", s); print "X\tQ\t" c "\t" $2 "\t" s }' "$d/pins"
	done
}

# "claim<TAB>holder" for every pin resource an ENABLED node (itself and all
# ancestors not disabled) holds: the pinctrl groups of its live state (the
# first "default", then "init", as the pinctrl core applies them) and each
# GPIO line in a *-gpios property (controller phandle + cells but the flags).
# With a pinctrl index ($2, from LDTO_pinctrlIndex) each group and GPIO line
# also claims its pads, "pad <name> on <controller>", so two different groups
# (or a group and a GPIO) that mux the same pad are seen too.
LDTO_dtbClaims()
{
	{
		if [ -n "${2:-}" ]; then cat "$2"; fi
		LDTO_dtbFlat "$1"
	} | awk -F'\t' '
	function hex(s,   i, c, v) {
		s = tolower(s); sub(/^0x/, "", s); v = 0
		for (i = 1; i <= length(s); i++) {
			c = index("0123456789abcdef", substr(s, i, 1)); if (!c) break
			v = v * 16 + c - 1
		}
		return v
	}
	function cells(v, a,   n) { gsub(/[<>,]/, " ", v); return split(v, a, " ") }
	function strs(v, a,   n, i, k) {
		n = split(v, q_, "\""); k = 0
		for (i = 2; i <= n; i += 2) a[++k] = q_[i]
		return k
	}
	function parent(p) { if (p == "/") return ""; sub(/\/[^\/]+$/, "", p); return p == "" ? "/" : p }
	function base(p) { sub(/^.*\//, "", p); return p }
	function enabled(p) {
		while (p != "") { if (st[p] == "\"disabled\"") return 0; p = parent(p) }
		return 1
	}
	# The pinctrl controller (in the debugfs index) a node sits under.
	function ctrlof(p) {
		while (p != "") { if (p in isctrl) return p; p = parent(p) }
		return ""
	}
	function claimpad(c, name, holder) {
		if (name == "" || !((c, name) in ispad)) return
		print "pad " name " on " c "\t" holder
	}
	# Pads of pinctrl group node gp: the driver groups named by "groups",
	# the pads named by "pins" (sunxi, generic pinconf) and the bank/pin
	# cells of "rockchip,pins", in the node and its subnodes; else the node
	# name as a group (rockchip registers each DT group under its own name).
	function grouppads(gp, holder,   c, i, j, k, q, a, t, found) {
		c = ctrlof(gp)
		if (c == "") return
		found = 0
		for (i = 1; i <= nn; i++) {
			q = nodes[i]
			if (q != gp && index(q, gp "/") != 1) continue
			if ((q, "groups") in pv) {
				k = strs(pv[q, "groups"], a)
				for (j = 1; j <= k; j++) if ((c, a[j]) in gpads) { found = 1; padsof(c, a[j], holder) }
			}
			if ((q, "pins") in pv) {
				k = strs(pv[q, "pins"], a)
				for (j = 1; j <= k; j++) if ((c, a[j]) in ispad) { found = 1; claimpad(c, a[j], holder) }
			}
			if ((q, "rockchip,pins") in pv) {
				k = cells(pv[q, "rockchip,pins"], t)
				for (j = 1; j + 1 <= k; j += 4) {
					found = 1
					claimpad(c, pnum[c, firstpin[c] + hex(t[j]) * 32 + hex(t[j + 1])], holder)
				}
			}
		}
		if (!found && ((c, base(gp)) in gpads)) padsof(c, base(gp), holder)
	}
	function padsof(c, g, holder,   k, a, j) {
		k = split(gpads[c, g], a, " ")
		for (j = 1; j <= k; j++) claimpad(c, a[j], holder)
	}
	# Pad of GPIO line "off" (and "bank" for 3-cell controllers) on gpio
	# controller g: through its gpio-ranges (meson), as a pinctrl controller
	# itself (sunxi: first pin + bank * 32 + pin), or by its label (rockchip
	# names pads "<bank label>-<n>").
	function gpiopad(g, bank, off, three, holder,   k, t, j, go, po, cnt, c) {
		if ((g, "gpio-ranges") in pv) {
			k = cells(pv[g, "gpio-ranges"], t)
			for (j = 1; j + 3 <= k; j += 4) {
				go = hex(t[j + 1]); po = hex(t[j + 2]); cnt = hex(t[j + 3])
				if (off >= go && off < go + cnt) {
					c = phpath[hex(t[j])]
					claimpad(c, pnum[c, po + off - go], holder)
					return
				}
			}
			return
		}
		if (g in isctrl) {
			claimpad(g, pnum[g, firstpin[g] + (three ? bank * 32 : 0) + off], holder)
			return
		}
		c = ctrlof(g)
		if (c != "" && (g in label)) claimpad(c, label[g] "-" off, holder)
	}
	$1 == "X" {
		isctrl[$3] = 1
		if ($2 == "G") gpads[$3, $4] = gpads[$3, $4] " " $5
		else {
			ispad[$3, $5] = 1; pnum[$3, $4 + 0] = $5
			if (!($3 in firstpin) || $4 + 0 < firstpin[$3]) firstpin[$3] = $4 + 0
		}
		next
	}
	$1 == "N" { nodes[++nn] = $2; next }
	$1 != "P" { next }
	{
		p = $2; n = $3; v = $4
		if (p == "/__symbols__") { gsub(/"/, "", v); label[v] = n; next }
		if (n == "status") st[p] = v
		else if (n == "phandle") { cells(v, t); phpath[hex(t[1])] = p }
		else if (n == "#gpio-cells") { cells(v, t); gc[p] = hex(t[1]) }
		else if (n == "pinctrl-names") pn[p] = v
		else if (n ~ /^pinctrl-[0-9]+$/) { k = n; sub(/^pinctrl-/, "", k); pcs[p, k] = v }
		else if (n ~ /(^|-)gpios?$/) gv[p, ++gn[p]] = v
		if (n == "groups" || n == "pins" || n == "rockchip,pins" || n == "gpio-ranges") pv[p, n] = v
	}
	END {
		for (i = 1; i <= nn; i++) {
			p = nodes[i]
			if (p ~ /^\/__/ || !enabled(p)) continue
			if (p in pn) {
				m = split(pn[p], nm, ",")
				d = -1; it = -1
				for (j = 1; j <= m; j++) {
					s = nm[j]; gsub(/[" ]/, "", s)
					if (s == "default" && d < 0) d = j - 1
					if (s == "init" && it < 0) it = j - 1
				}
				for (j = 0; j <= 1; j++) {
					k = (j == 0) ? d : it
					if (k < 0 || !((p, k) in pcs)) continue
					c = cells(pcs[p, k], t)
					for (x = 1; x <= c; x++) {
						gp = phpath[hex(t[x])]
						print "pinctrl group " gp "\t" p
						grouppads(gp, p)
					}
				}
			}
			for (g = 1; g <= gn[p]; g++) {
				c = cells(gv[p, g], t)
				x = 1
				while (x <= c) {
					ph = hex(t[x])
					if (ph == 0) { x++; continue }
					ctrl = phpath[ph]
					nc = (ctrl in gc) ? gc[ctrl] : 2
					key = "GPIO " ctrl
					for (y = 1; y < nc; y++) key = key " " hex(t[x + y])
					print key "\t" p
					if (nc == 3) gpiopad(ctrl, hex(t[x + 1]), hex(t[x + 2]), 1, p)
					else if (nc >= 2) gpiopad(ctrl, 0, hex(t[x + 1]), 0, p)
					x += 1 + nc
				}
			}
		}
	}' | sort -u
}

# Claims held by two or more enabled nodes in $2 that were not already
# shared in $1: "claim<TAB>holder holder ...". A shared pad is reported only
# when no group or GPIO finding already names the same holders.
LDTO_newDoubleClaims()
{
	local a b x
	a=$(mktemp /tmp/ldto-claims.XXXXXX) || return 1
	b=$(mktemp /tmp/ldto-claims.XXXXXX) || { rm -f "$a"; return 1; }
	x=$(mktemp /tmp/ldto-claims.XXXXXX) || { rm -f "$a" "$b"; return 1; }
	LDTO_pinctrlIndex > "$x"
	if [ ! -s "$x" ]; then
		rm -f "$x"
		x=
	fi
	LDTO_dtbClaims "$1" "$x" > "$a"
	LDTO_dtbClaims "$2" "$x" > "$b"
	awk -F'\t' '
	FNR == NR { nb[$1]++; next }
	{ n[$1]++; h[$1] = h[$1] " " $2 }
	END {
		for (k in n) if (n[k] >= 2 && nb[k] < 2 && k !~ /^pad /) { seen[h[k]] = 1; print k "\t" substr(h[k], 2) }
		for (k in n) if (n[k] >= 2 && nb[k] < 2 && k ~ /^pad / && !(h[k] in seen)) print k "\t" substr(h[k], 2)
	}' "$a" "$b" | sort
	rm -f "$a" "$b" ${x:+"$x"}
}

# Nodes overlay $1 writes BELOW a fragment's target that already existed in
# $2 (the tree before it) and whose property values it changed in $3 (the
# tree after): the overlay meant to add a node and rewrote a live one (the
# fan-auto maps that replaced the base's cpu cooling maps). Properties set on
# the target node itself are the normal way an overlay adjusts a node and are
# not reported. Prints "path<TAB>prop prop ...".
LDTO_overwrites()
{
	{
		LDTO_dtbFlat "$1" | sed 's/^/O\t/'
		LDTO_dtbFlat "$2" | sed 's/^/A\t/'
		LDTO_dtbFlat "$3" | sed 's/^/B\t/'
	} | awk -F'\t' '
	function strs(v, a,   n, i, out) {
		n = split(v, a, "\"")
		out = 0
		for (i = 2; i <= n; i += 2) b_[++out] = a[i]
		return out
	}
	$1 == "O" && $2 == "N" { onode[++on] = $3; next }
	$1 == "O" && $2 == "P" {
		if ($4 == "target-path") { v = $5; gsub(/"/, "", v); tgt[$3] = v }
		else if ($3 == "/__fixups__") {
			c = strs($5)
			for (i = 1; i <= c; i++) {
				s = b_[i]
				if (s ~ /:target:0$/) { f = s; sub(/:target:0$/, "", f); fixlabel[f] = $4 }
			}
		}
		next
	}
	$1 == "A" && $2 == "N" { pre[$3] = 1; next }
	$1 == "A" && $2 == "P" {
		if ($3 == "/__symbols__") { v = $5; gsub(/"/, "", v); sym[$4] = v }
		before[$3 SUBSEP $4] = $5
		next
	}
	$1 == "B" && $2 == "P" { after[$3 SUBSEP $4] = $5; next }
	END {
		for (f in fixlabel) if (!(f in tgt) && (fixlabel[f] in sym)) tgt[f] = sym[fixlabel[f]]
		for (i = 1; i <= on; i++) {
			p = onode[i]
			if (p !~ /^\/fragment@[0-9]+\/__overlay__\//) continue
			f = p; sub(/\/__overlay__\/.*$/, "", f)
			if (!(f in tgt)) continue
			rel = p; sub(/^\/fragment@[0-9]+\/__overlay__/, "", rel)
			dest = (tgt[f] == "/") ? rel : tgt[f] rel
			if (!(dest in pre)) continue
			chg = ""
			for (k in after) {
				split(k, kk, SUBSEP)
				if (kk[1] != dest || kk[2] == "phandle") continue
				if ((k in before) && before[k] != after[k]) chg = chg " " kk[2]
			}
			if (chg != "") print dest "\t" substr(chg, 2)
		}
	}' | sort -u
}

# Replay the merge's new steps one at a time onto $1 and refuse on any
# finding. Prints the findings as WARNING lines; returns 1 if any.
LDTO_mergeAfterCheck()
{
	local base="$1" cur next tmp dto dtbo line found=0
	shift
	tmp=$(mktemp -d /tmp/ldto-after.XXXXXX) || return 1
	cur="$base"
	for dto in "$@"; do
		dtbo=$(LDTO_getDTBO "$dto")
		next="$tmp/$dto.dtb"
		if ! fdtoverlay -i "$cur" -o "$next" "$dtbo" 2>/dev/null; then
			rm -rf "$tmp"
			return 1
		fi
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			echo "WARNING: after-check: '$dto' rewrites existing node ${line%%$TAB_CHAR*} (${line#*$TAB_CHAR}) -- it creates a node the tree already has" >&2
			found=1
		done < <(LDTO_overwrites "$dtbo" "$cur" "$next")
		cur="$next"
	done
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		echo "WARNING: after-check: ${line%%$TAB_CHAR*} is held by two enabled nodes: ${line#*$TAB_CHAR}" >&2
		found=1
	done < <(LDTO_newDoubleClaims "$base" "$cur")
	rm -rf "$tmp"
	[ "$found" -eq 0 ]
}

# ESP single-overlay apply used to live here as LDTO_apply + LDTO_mergeBase;
# both were uncalled after the chain-merge rewrite (R13). Use: ldto merge …

LDTO_merge()
{
	local dry_run=0 force=0 check=1
	local -a args=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run|-n)
				dry_run=1
				shift
				;;
			--force)
				force=1
				shift
				;;
			--no-check)
				check=0
				shift
				;;
			--help|-h)
				echo "$0 merge [--dry-run|-n] [--force] [--no-check] OVERLAY [OVERLAY...]" >&2
				echo "  Auto-merges providers from dt.deps (autoload chain)." >&2
				echo "  Conflict gate against the overlays already merged (the override's" >&2
				echo "  record), then fdtoverlay of the new steps; writes the EFI override" >&2
				echo "  only if every step is clean, stamped with what it holds." >&2
				echo "  Refuses while this boot runs an override that has been removed" >&2
				echo "  (reset, not yet rebooted); --force merges anyway." >&2
				echo "  After-check: refuses if a new overlay rewrites a node the tree" >&2
				echo "  already has, or leaves a pinctrl group / GPIO line held by two" >&2
				echo "  enabled nodes that was not shared before; --no-check skips it." >&2
				return 0
				;;
			--)
				shift
				args+=("$@")
				break
				;;
			-*)
				echo "$FUNCNAME: unknown option $1" >&2
				return 1
				;;
			*)
				args+=("$1")
				shift
				;;
		esac
	done

	if [ ${#args[@]} -eq 0 ]; then
		LDTO_list
		return 1
	fi

	if ! LDTO_requireValidNames "${args[@]}"; then
		return 1
	fi

	LDTO_importDTConfig
	LDTO_loadMap

	local -a seq=()
	local seq_out
	seq_out=$(LDTO_planSequence "${args[@]}") || return 1
	[ -n "$seq_out" ] && mapfile -t seq <<<"$seq_out"
	if [ ${#seq[@]} -eq 0 ]; then
		echo "WARNING: merge not clean — empty plan" >&2
		return 1
	fi

	echo "Merge plan (autoload order, ${#seq[@]} step(s)): ${seq[*]}" >&2

	# Next boot vs this boot. With no override file the merge base is this
	# boot's DT; if that is an override which has since been removed (ldto
	# reset, rm), merging would rebuild the removed overlays.
	LDTO_nextBootState
	if [ "$LDTO_STATE" = "removed" ]; then
		if [ "$force" -eq 0 ]; then
			echo "WARNING: merge refused — $LDTO_STATE_MSG" >&2
			echo "WARNING: with no override file the merge base is this boot's DT, which still holds the removed overlays; --force merges onto it anyway" >&2
			return 1
		fi
		echo "WARNING: --force: merging onto this boot's DT, which holds the removed overlays" >&2
	elif [ -n "$LDTO_STATE_MSG" ]; then
		echo "WARNING: $LDTO_STATE_MSG" >&2
	fi
	if [ -n "$LDTO_STATE_NOTE" ]; then
		echo "WARNING: $LDTO_STATE_NOTE" >&2
	fi

	# Need EFI path for real merge; dry-run can preflight against firmware only.
	if [ "$dry_run" -eq 0 ]; then
		LDTO_checkFirmwareDT || return 1
		LDTO_findEFIDTBPath RW || return 1
	else
		# Prefer override path if mounts allow (read-only OK for base choice)
		LDTO_findEFIDTBPath 2>/dev/null || true
	fi
	local override=
	if [ -n "${PATH_OF_EFI_DTB:-}" ] && [ -f "$PATH_OF_EFI_DTB/$DT_OVERRIDE" ]; then
		override="$PATH_OF_EFI_DTB/$DT_OVERRIDE"
	fi

	# What the next boot already holds: the override's record.
	local -a rec=() rec_ok=() new=() merged=()
	local base_kind= edited=0 uboot= rec_out stored dto r inrec
	if [ -n "$override" ]; then
		uboot=$(LDTO_dtbChosen "$override" "$LDTO_PROP_UBOOT")
		rec_out=$(LDTO_dtbChosen "$override" "$LDTO_PROP_MERGED")
		if [ -n "$rec_out" ]; then
			read -r -a rec <<<"$rec_out"
		fi
		stored=$(LDTO_dtbChosen "$override" "$LDTO_PROP_ID")
		if [ -z "$stored" ]; then
			base_kind=override-unstamped
		elif [ "$(LDTO_dtbComputeId "$override")" != "$stored" ]; then
			base_kind=override-modified
			edited=1
		else
			base_kind="override:${stored:0:16}"
		fi
		if [ -n "$(LDTO_dtbChosen "$override" "$LDTO_PROP_EDITED")" ]; then
			edited=1
		fi
	fi
	for dto in "${rec[@]}"; do
		if [ -n "$(LDTO_getDTBO "$dto")" ]; then
			rec_ok+=("$dto")
		else
			echo "WARNING: merged overlay '$dto' is not in this LWT package any more; not conflict-checked" >&2
		fi
	done
	for dto in "${seq[@]}"; do
		inrec=0
		for r in "${rec[@]}"; do
			if [ "$r" = "$dto" ]; then
				inrec=1
				break
			fi
		done
		if [ "$inrec" -eq 1 ]; then
			echo "Overlay $dto: already merged" >&2
		else
			new+=("$dto")
		fi
	done
	if [ ${#new[@]} -eq 0 ]; then
		echo "Merge: nothing to do — every planned overlay is already in the override" >&2
		return 0
	fi

	# Gate the new steps against what the next boot already holds, not the
	# running tree; overlays active only at runtime are reported, not gated.
	if ! LDTO_CONFLICT_ACTIVES=0 LDTO_enableGateConflicts "${new[@]}" "${rec_ok[@]}"; then
		echo "WARNING: merge aborted — pin or resource conflicts with the request or with overlays already merged; ESP override not modified" >&2
		return 1
	fi
	local act listed
	while IFS= read -r act; do
		[ -n "$act" ] || continue
		listed=0
		for r in "${rec[@]}" "${seq[@]}"; do
			if [ "$r" = "$act" ]; then
				listed=1
				break
			fi
		done
		if [ "$listed" -eq 0 ]; then
			echo "WARNING: '$act' is active now but not merged: it is gone after reboot" >&2
		fi
	done < <(LDTO_listAppliedOverlays)
	if [ "$dry_run" -eq 1 ]; then
		echo "DRY-RUN: pin/resource conflicts OK" >&2
	fi

	local base_dtb target_dtb out base_tmp= uv p
	if [ -n "$override" ]; then
		base_dtb="$override"
		echo "Merge base: existing override $base_dtb" >&2
	elif [ "$dry_run" -eq 1 ] && [ ! -r "$PATH_OF_DT" ]; then
		# Host-side dry-run (same as enable --dry-run): plan + conflicts ran;
		# the chain check needs a base DTB. Still fail on a missing .dtbo.
		local missing=0
		for dto in "${new[@]}"; do
			if [ -z "$(LDTO_getDTBO "$dto")" ]; then
				echo "WARNING: dry-run: missing .dtbo for '$dto'" >&2
				missing=1
			fi
		done
		if [ "$missing" -eq 1 ]; then
			echo "WARNING: dry-run aborted — plan has missing .dtbo" >&2
			return 1
		fi
		echo "DRY-RUN: fdtoverlay chain preflight SKIPPED (no readable $PATH_OF_DT and no existing override); no ESP write" >&2
		return 0
	else
		# No override: the next boot would use U-Boot's built-in DT, which
		# Linux sees only as this boot's DT. Drop the per-boot /chosen
		# values the bootloader and EFI stub put there, and any stale record.
		LDTO_checkFirmwareDT || return 1
		base_tmp=$(mktemp /tmp/ldto-base.XXXXXX.dtb) || return 1
		cp -f "$PATH_OF_DT" "$base_tmp"
		uv=$(LDTO_dtbChosen "$PATH_OF_DT" u-boot,version)
		for p in "${LDTO_VOLATILE_CHOSEN[@]}" "$LDTO_PROP_ID" "$LDTO_PROP_MERGED" \
				"$LDTO_PROP_BASE" "$LDTO_PROP_EDITED" "$LDTO_PROP_UBOOT"; do
			fdtput -d "$base_tmp" /chosen "$p" 2>/dev/null || true
		done
		base_dtb="$base_tmp"
		if [ "$LDTO_STATE" = "removed" ]; then
			base_kind="running-forced"
		else
			base_kind="builtin:${uv:-unknown}"
			uboot="$uv"
		fi
		echo "Merge base: this boot's DT (U-Boot built-in${uv:+, $uv}; per-boot /chosen values removed)" >&2
	fi

	out=$(mktemp /tmp/ldto-merge.XXXXXX.dtb)
	if ! LDTO_chainPreflight "$base_dtb" "$out" "${new[@]}"; then
		rm -f "$out" "$base_tmp"
		echo "WARNING: merge aborted — ESP override not modified" >&2
		return 1
	fi
	if [ "$check" -eq 1 ] && ! LDTO_mergeAfterCheck "$base_dtb" "${new[@]}"; then
		rm -f "$out" "$base_tmp"
		echo "WARNING: merge aborted — after-check findings above; ESP override not modified (--no-check merges anyway)" >&2
		return 1
	fi
	rm -f "$base_tmp"

	merged=("${rec[@]}" "${new[@]}")
	if ! LDTO_stampDTB "$out" "$base_kind" "$edited" "$uboot" "${merged[@]}"; then
		rm -f "$out"
		echo "WARNING: merge aborted — could not write the merge record; ESP override not modified" >&2
		return 1
	fi

	if [ "$dry_run" -eq 1 ]; then
		echo "DRY-RUN: chain applies cleanly (${#new[@]} new overlay(s)); no ESP write" >&2
		rm -f "$out"
		return 0
	fi

	target_dtb="$PATH_OF_EFI_DTB/$DT_OVERRIDE"
	local target_dtb_path="${target_dtb%/*}"
	if [ ! -d "$target_dtb_path" ]; then
		mkdir -p "$target_dtb_path" || {
			echo "WARNING: merge not clean — cannot create $target_dtb_path" >&2
			rm -f "$out"
			return 1
		}
	fi
	# Atomic-ish replace: write temp next to target when possible, then mv.
	local staged
	staged=$(mktemp "${target_dtb_path}/.ldto-merge.XXXXXX") || staged=""
	if [ -n "$staged" ]; then
		if ! cp -f "$out" "$staged" || ! mv -f "$staged" "$target_dtb"; then
			echo "WARNING: merge not clean — failed installing override to $target_dtb" >&2
			rm -f "$out" "$staged"
			return 1
		fi
	else
		if ! install -m 644 "$out" "$target_dtb"; then
			echo "WARNING: merge not clean — failed installing override to $target_dtb" >&2
			rm -f "$out"
			return 1
		fi
	fi
	rm -f "$out"
	sync 2>/dev/null || true

	for dto in "${new[@]}"; do
		echo "Overlay $dto: merged for next boot" >&2
	done
	echo "Merge clean: ${#new[@]} overlay(s) → $target_dtb (override now holds: ${merged[*]}) -- reboot to apply" >&2
}

LDTO_checkOverrideDT()
{
	LDTO_importDTConfig
	LDTO_findEFIDTBPath $1
	PATH_OF_DTB_OVERRIDE="$PATH_OF_EFI_DTB/$DT_OVERRIDE"
	if [ ! -f "$PATH_OF_DTB_OVERRIDE" ]; then
		echo "$FUNCNAME: no merged overlays detected on system." >&2
		return 1
	fi
}

LDTO_diff()
{
	LDTO_checkOverrideDT
	LDTO_checkFirmwareDT
	diff -u --color --suppress-common-lines --label=CURRENT <(dtc -I dtb -O dts "$PATH_OF_DT" 2> /dev/null) --label=NEXT <(dtc -I dtb -O dts "$PATH_OF_DTB_OVERRIDE" 2> /dev/null)
}

LDTO_show()
{
	LDTO_checkOverrideDT
	if [ -z "$1" ]; then
		dtc -I dtb -O dts "$PATH_OF_DTB_OVERRIDE" 2> /dev/null | less
	else
		local dtbo_file=$(LDTO_getDTBO "$1")
		if [ ! -z "$dtbo_file" ]; then
			dtc -I dtb -O dts "$dtbo_file" 2> /dev/null | less
		fi
	fi
}

LDTO_edit()
{
	# R12: fail-closed — never write override if dtc decompile/recompile fails.
	LDTO_checkOverrideDT RW
	local dts staged err
	dts=$(mktemp /tmp/ldto-edit.XXXXXX.dts) || return 1
	if ! err=$(dtc -I dtb -O dts "$PATH_OF_DTB_OVERRIDE" -o "$dts" 2>&1); then
		echo "WARNING: edit aborted — dtc decompile failed; override unchanged" >&2
		[ -n "$err" ] && echo "WARNING: dtc: $err" >&2
		rm -f "$dts"
		return 1
	fi
	"${EDITOR:-vim}" "$dts" || {
		echo "WARNING: edit aborted — editor failed; override unchanged" >&2
		rm -f "$dts"
		return 1
	}
	staged=$(mktemp "${PATH_OF_DTB_OVERRIDE%/*}/.ldto-edit.XXXXXX" 2>/dev/null) || \
		staged=$(mktemp /tmp/ldto-edit.XXXXXX.dtb) || {
			rm -f "$dts"
			return 1
		}
	if ! err=$(dtc -I dts -O dtb "$dts" -o "$staged" 2>&1); then
		echo "WARNING: edit aborted — dtc recompile failed; override unchanged" >&2
		[ -n "$err" ] && echo "WARNING: dtc: $err" >&2
		rm -f "$dts" "$staged"
		return 1
	fi
	# Keep the merge record, marked as edited (advisory), and re-stamp so
	# the next boot can be told apart from this one.
	local rec base uboot
	rec=$(LDTO_dtbChosen "$PATH_OF_DTB_OVERRIDE" "$LDTO_PROP_MERGED")
	base=$(LDTO_dtbChosen "$PATH_OF_DTB_OVERRIDE" "$LDTO_PROP_BASE")
	uboot=$(LDTO_dtbChosen "$PATH_OF_DTB_OVERRIDE" "$LDTO_PROP_UBOOT")
	# shellcheck disable=SC2086 # rec is a space-separated name list
	if ! LDTO_stampDTB "$staged" "${base:-override-unstamped}" 1 "$uboot" $rec; then
		echo "WARNING: edit aborted — could not write the merge record; override unchanged" >&2
		rm -f "$dts" "$staged"
		return 1
	fi
	if ! mv -f "$staged" "$PATH_OF_DTB_OVERRIDE"; then
		echo "WARNING: edit aborted — failed installing override; left at $staged" >&2
		rm -f "$dts"
		return 1
	fi
	rm -f "$dts"
	echo "Overlay: edited override written to $PATH_OF_DTB_OVERRIDE" >&2
}

LDTO_current()
{
	LDTO_checkFirmwareDT
	dtc -I dtb -O dts "$PATH_OF_DT" 2> /dev/null | less
}

LDTO_reset()
{
	LDTO_checkOverrideDT RW
	local stamp base booted
	stamp=$(LDTO_dtbChosen "$PATH_OF_DTB_OVERRIDE" "$LDTO_PROP_ID")
	base=$(LDTO_dtbChosen "$PATH_OF_DTB_OVERRIDE" "$LDTO_PROP_BASE")
	booted=$(LDTO_bootedChosen "$LDTO_PROP_ID")
	rm -f "$PATH_OF_DTB_OVERRIDE"
	# A stamped boot DT already tells merge/status that this boot ran an
	# override. Without one, leave a per-boot marker -- unless the removed
	# file was merged onto the built-in DT in this boot, which proves this
	# boot's DT is the built-in one and a merge base built from it is right.
	if [ -z "$booted" ] && [ -d "$PATH_OF_PROC_DT" ]; then
		case "$base" in
		builtin:*) ;;
		*)
			mkdir -p "$PATH_OF_RUN"
			printf 'boot_id=%s\nremoved=%s\nstamp=%s\n' "$(LDTO_bootId)" \
				"$PATH_OF_DTB_OVERRIDE" "${stamp:-none}" > "$PATH_OF_RUN/reset-pending"
			;;
		esac
	fi
	echo "Overlay: reset for next boot -- the next boot uses U-Boot's built-in DT; reboot before the next 'ldto merge' (this boot's DT still holds the removed overlays)" >&2
}


GPIO_MAP_FILE=

LDTO_loadGpioMap()
{
	GPIO_MAP_FILE="$VENDOR/$BOARD/gpio.map"
	if [ ! -f "$GPIO_MAP_FILE" ]; then
		GPIO_MAP_FILE=""
	fi
}

# Lookup gpio.map row by SoC pad Name (column 6). Prints:
# Header Pin Chip Line sysfs Name Pad Ref Desc
LDTO_gpioLookupName()
{
	local name="$1"
	local bare="$name"
	while [ "${bare%\*}" != "$bare" ]; do
		bare="${bare%\*}"
	done
	[ -z "$GPIO_MAP_FILE" ] && return 1
	# Match Name column; allow trailing *s in map (e.g. GPIOAO_8*, TEST_N**)
	awk -F '\t' -v n="$bare" '
		/^#/ || NF < 6 { next }
		{
			mapn = $6
			sub(/\*+$/, "", mapn)
			if (mapn == n) {
				print $0
				found = 1
			}
		}
		END { exit found ? 0 : 1 }
	' "$GPIO_MAP_FILE"
}

# Lookup by header + pin number
LDTO_gpioLookupPin()
{
	local header="$1" pin="$2"
	[ -z "$GPIO_MAP_FILE" ] && return 1
	awk -F '\t' -v h="$header" -v p="$pin" '
		BEGIN { hl = tolower(h) }
		/^#/ || NF < 2 { next }
		tolower($1) == hl && $2 == p { print; found = 1 }
		END { exit found ? 0 : 1 }
	' "$GPIO_MAP_FILE"
}

LDTO_getDTS()
{
	# Prefer source .dts (comments); fall back to nothing if only .dtbo
	local base="$PATH_DTBO/$1"
	if [ -f "${base}.dts" ]; then
		echo "${base}.dts"
	elif [ -L "${base}.dts" ]; then
		echo "${base}.dts"
	fi
}

# Print free-form header comments that precede /dts-v1/
LDTO_extractHeaderComments()
{
	local dts="$1"
	[ -f "$dts" ] || return 0
	awk '
		BEGIN { in_block = 0; spdx_done = 0 }
		/^\/dts-v1\// { exit }
		/^\/\// {
			# keep SPDX line out of Description (shown separately)
			if ($0 ~ /SPDX-License-Identifier/) next
			print
			next
		}
		/^\/\*/ {
			in_block = 1
			# strip leading /*
			line = $0
			sub(/^\/\*+[[:space:]]?/, "", line)
			if (line ~ /\*\//) {
				sub(/[[:space:]]*\*\/.*/, "", line)
				in_block = 0
				if (line != "" && line !~ /^[[:space:]]*$/) print line
				next
			}
			if (line != "" && line !~ /^[[:space:]]*$/) print line
			next
		}
		in_block {
			line = $0
			if (line ~ /\*\//) {
				sub(/[[:space:]]*\*\/.*/, "", line)
				sub(/^[[:space:]]*\*[[:space:]]?/, "", line)
				if (line != "" && line !~ /^[[:space:]]*$/) print line
				in_block = 0
				next
			}
			sub(/^[[:space:]]*\*[[:space:]]?/, "", line)
			print line
			next
		}
	' "$dts"
}

# Collect unique SoC pad names referenced in DTS body (not GPIO_ACTIVE_*)
LDTO_extractGpioNames()
{
	local dts="$1"
	[ -f "$dts" ] || return 0
	# Body only (after /dts-v1/) so header prose is not double-counted as "from DTS"
	awk '
		BEGIN { body = 0 }
		/^\/dts-v1\// { body = 1 }
		body { print }
	' "$dts" | grep -oE '\b(GPIO[A-Z][A-Z0-9_]*|GPIODV_[0-9]+|TEST_N|RK_P[A-Z0-9_]+|PIN_[A-Z0-9_]+)\b' \
		| grep -vE '^(GPIO_ACTIVE_|GPIO_OPEN_|GPIO_PULL_|GPIO_PERSISTENT)' \
		| sort -u
}

# Reverse-deps: consumers that list this overlay as a provider
LDTO_requiredBy()
{
	local name="$1"
	[ -e "$DEPS_FILE" ] || return 0
	awk -F '\t' -v n="$name" '
		/^#/ || NF < 2 { next }
		{
			for (i = 2; i <= NF; i++) {
				# providers may be space-separated in field 2+
				split($i, a, /[[:space:]]+/)
				for (j in a) if (a[j] == n) print $1
			}
		}
	' "$DEPS_FILE" | sort -u
}

LDTO_infoHelp()
{
	echo "$0 info [OVERLAY|ALIAS]..." >&2
	echo "  Show overlay description, deps, map aliases, and gpio.map pinout." >&2
	echo "  Set VENDOR/BOARD when not running on the target board." >&2
}

LDTO_info()
{
	if [ -z "$1" ]; then
		LDTO_infoHelp
		return 1
	fi
	LDTO_loadMap
	LDTO_loadDeps
	LDTO_loadGpioMap

	local dto
	for dto in "$@"; do
		local dto_real
		dto_real=$(LDTO_getAliasDT "$dto")
		if [ -n "$dto_real" ]; then
			echo "Alias: $dto -> $dto_real"
			dto=$dto_real
		fi

		local dts dtbo
		dts=$(LDTO_getDTS "$dto")
		dtbo=$(LDTO_getDTBO "$dto")
		if [ -z "$dts" ] && [ -z "$dtbo" ]; then
			echo "Overlay $dto: not found under $PATH_DTBO" >&2
			return 1
		fi

		echo "Overlay: $dto"
		if [ -n "$dts" ]; then
			if [ -L "$dts" ]; then
				echo "Source:  $dts -> $(readlink -f "$dts" 2>/dev/null || readlink "$dts")"
			else
				echo "Source:  $dts"
			fi
		fi
		if [ -n "$dtbo" ]; then
			echo "Binary:  $dtbo"
		else
			echo "Binary:  (missing — run make BOARD_NAME=$BOARD)"
		fi

		# H40P / product aliases that point at this overlay
		local aliases=""
		local a
		for a in "${!MAP_ALIAS_DT[@]}"; do
			if [ "${MAP_ALIAS_DT[$a]}" = "$dto" ]; then
				aliases="$aliases $a"
			fi
		done
		if [ -n "$aliases" ]; then
			echo "Map aliases:$aliases"
		fi

		# Requires (providers)
		local prov=""
		if [[ -v "MAP_DEPS[$dto]" ]]; then
			prov="${MAP_DEPS[$dto]}"
		fi
		if [ -n "$prov" ]; then
			echo "Requires: $prov"
		else
			echo "Requires: (none)"
		fi

		local rev
		rev=$(LDTO_requiredBy "$dto" | tr '\n' ' ')
		if [ -n "${rev// }" ]; then
			echo "Required by: $rev"
		fi

		# Resource tokens (header comments + derived aliases)
		if [ -n "$dts" ] && [ -f "$dts" ]; then
			local res_line
			res_line=$(LDTO_exclusiveClaims "$dto" 2>/dev/null | sort -u | tr '\n' ' ')
			if [ -n "${res_line// }" ]; then
				echo "Resource claims: $res_line"
			fi
		fi

		# Active?
		if [ -d "$PATH_OF_CONFIG" ] && [ -e "$PATH_OF_CONFIG/$dto" ]; then
			echo "Active: yes ($(cat "$PATH_OF_CONFIG/$dto/status" 2>/dev/null || echo applied))"
		elif [ -d "$PATH_OF_CONFIG" ]; then
			echo "Active: no"
		fi

		if [ -n "$dts" ]; then
			echo
			local desc
			desc=$(LDTO_extractHeaderComments "$dts")
			if [ -n "$desc" ]; then
				# Prefer structured Summary/Pins/Requires/Notes if present
				if printf '%s\n' "$desc" | grep -q '^Summary:'; then
					printf '%s\n' "$desc" | awk '
						/^[Cc]opyright/ { next }
						/^[Aa]uthor:/ { next }
						{ print "  " $0 }
					'
				else
					echo "Description:"
					printf '%s\n' "$desc" | sed 's/^/  /'
				fi
			else
				echo "Description:"
				echo "  (no header comment)"
			fi
		fi

		# GPIO cross-ref table
		echo
		if [ -z "$GPIO_MAP_FILE" ]; then
			echo "GPIO map: (not available for $VENDOR/$BOARD)"
		else
			echo "GPIO connections (DTS pad refs x gpio.map):"
			printf '  %-6s %-4s %-14s %-8s %-10s %s\n' "Header" "Pin" "Name" "Pad" "Chip:Line" "Ref / Desc"
			local name row header pin chip line sysfs gname pad ref desc
			local any=0
			while IFS= read -r name; do
				[ -z "$name" ] && continue
				if row=$(LDTO_gpioLookupName "$name"); then
					# may be multiple rows (unlikely); print each
					while IFS= read -r r; do
						[ -z "$r" ] && continue
						IFS=$'\t' read -r header pin chip line sysfs gname pad ref desc <<<"$r"
						printf '  %-6s %-4s %-14s %-8s %-10s %s\n' \
							"$header" "$pin" "$gname" "$pad" "${chip}:${line}" "${ref}${desc:+ / $desc}"
						any=1
					done <<<"$row"
				else
					printf '  %-6s %-4s %-14s %-8s %-10s %s\n' \
						"-" "-" "$name" "-" "-" "(not in gpio.map)"
					any=1
				fi
			done < <(LDTO_extractGpioNames "$dts")
			if [ "$any" -eq 0 ]; then
				echo "  (no SoC pad names in DTS body — bus/pinctrl may use phandles;"
				echo "   see Description for header pin notes, or enable provider bus overlay)"
			fi
		fi

		# Header pin notes from comment prose × gpio.map
		if [ -n "$dts" ] && [ -n "$GPIO_MAP_FILE" ]; then
			local pin_notes def_hdr hdr_from_cmt pins_csv
			pin_notes=$(LDTO_extractHeaderComments "$dts")
			def_hdr=$(grep -v '^#' "$GPIO_MAP_FILE" | head -n1 | cut -f1)
			# First header named in the comments that gpio.map knows (a
			# connector the map does not list, e.g. a silkscreen alias, is
			# not a default for bare "pin N" notes)
			hdr_from_cmt=$(printf '%s\n' "$pin_notes" | grep -oE '\b[0-9]*[Jj][0-9]+\b' | awk -F '\t' '
				NR == FNR { if ($0 !~ /^#/) known[tolower($1)] = 1; next }
				{ k = tolower($0); if (k in known) { print; exit } }
			' "$GPIO_MAP_FILE" - || true)
			[ -n "$hdr_from_cmt" ] && def_hdr=$hdr_from_cmt

			# POSIX awk only (Debian default is mawk): no IGNORECASE, no \< \>,
			# no /re/i. Word matches run on a lowercased copy (same length, so
			# RSTART/RLENGTH index the original); a leading [^a-z0-9_] class
			# stands in for the word boundary.
			pins_csv=$(
				printf '%s\n' "$pin_notes" | awk -v defh="$def_hdr" '
					function emit(h, p) {
						p = p + 0
						if (p < 1 || p > 99) return
						key = h SUBSEP p
						if (key in seen) return
						seen[key] = 1
						print h "\t" p
					}
					# Header token (7J1, 2J3, J1, J12, ...) at the start of s
					function hdr(s) {
						match(s, /[0-9]*[Jj][0-9]+/)
						return substr(s, RSTART, RLENGTH)
					}
					{
						line = $0
						# 7J1.24 / J1.18
						while (match(line, /(^|[^A-Za-z0-9_])[0-9]*[Jj][0-9]+\.[0-9]+/)) {
							tok = substr(line, RSTART, RLENGTH)
							sub(/^[^0-9Jj]/, "", tok)
							split(tok, a, /\./)
							emit(a[1], a[2])
							line = substr(line, RSTART + RLENGTH)
						}
						line = $0
						lc = tolower(line)
						# 7J1 pin 22 / J1 pin 22
						while (match(lc, /(^|[^a-z0-9_])[0-9]*j[0-9]+[[:space:]]+pin[[:space:]]*[0-9]+/)) {
							tok = substr(line, RSTART, RLENGTH)
							sub(/^[^0-9Jj]/, "", tok)
							h = hdr(tok)
							match(tok, /[0-9]+$/)
							emit(h, substr(tok, RSTART, RLENGTH))
							line = substr(line, RSTART + RLENGTH)
							lc = substr(lc, RSTART + RLENGTH)
						}
						lc = tolower($0)
						# bare "pin 22" (word pin, not pins / pinmux / pinctrl)
						while (match(lc, /(^|[^a-z0-9_])pin[[:space:]]+[0-9]+/)) {
							tok = substr(lc, RSTART, RLENGTH)
							match(tok, /[0-9]+/)
							emit(defh, substr(tok, RSTART, RLENGTH))
							lc = substr(lc, RSTART + RLENGTH)
						}
						# "Pins 19 (MOSI), 21 ..." or "pins (7J1 19/21/23/24)" — plural only
						if (match(tolower($0), /(^|[^a-z0-9_])pins[[:space:]]+/)) {
							rest = substr($0, RSTART + RLENGTH)
							if (match(rest, /^\([^)]*\)/)) {
								inner = substr(rest, 2, RLENGTH - 2)
								gsub(/[0-9]*[Jj][0-9]+/, " ", inner)
								n = split(inner, parts, /[^0-9]+/)
								for (i = 1; i <= n; i++)
									if (parts[i] != "") emit(defh, parts[i])
							} else {
								# strip (role) labels so SS0/CS0 digits are not pins
								gsub(/\([^)]*\)/, " ", rest)
								# stop before trailing prose (case-insensitive)
								if (match(tolower(rest), /[[:space:]]+(come|from|with|using|on)[[:space:]]/))
									rest = substr(rest, 1, RSTART - 1)
								n = split(rest, parts, /[^0-9]+/)
								for (i = 1; i <= n; i++)
									if (parts[i] != "") emit(defh, parts[i])
							}
						}
					}
				' | sort -t$'\t' -k1,1 -k2,2n
			)
			if [ -n "$pins_csv" ]; then
				echo
				echo "Header pin notes (comment text x gpio.map, header $def_hdr):"
				printf '  %-6s %-4s %-14s %-8s %s\n' "Header" "Pin" "Name" "Pad" "Ref"
				local seen_hp=""
				while IFS=$'\t' read -r h p; do
					[ -z "$p" ] && continue
					r=""
					if r=$(LDTO_gpioLookupPin "$h" "$p"); then
						true
					else
						map_def=$(grep -v '^#' "$GPIO_MAP_FILE" | head -n1 | cut -f1)
						if [ "$h" != "$map_def" ]; then
							r=$(LDTO_gpioLookupPin "$map_def" "$p" || true)
						fi
					fi
					if [ -n "$r" ]; then
						IFS=$'\t' read -r header pin chip line sysfs gname pad ref desc <<<"$r"
						# skip pure power/GND rows (noise from stray digit matches)
						case "$gname" in
							GND|5V|3.3V) continue ;;
						esac
						case " $seen_hp " in
							*" $header:$pin "*) continue ;;
						esac
						seen_hp="$seen_hp $header:$pin"
						printf '  %-6s %-4s %-14s %-8s %s\n' "$header" "$pin" "$gname" "$pad" "$ref"
					fi
					# omit unresolved silk-header misses when map fallback also failed
				done <<<"$pins_csv"
			fi
		fi

		echo
		echo "----"
	done
}


LDTO_conflictsHelp()
{
	echo "$0 conflicts [OVERLAY|ALIAS]..." >&2
	echo "  Report header pin collisions and resource-token exclusivity among" >&2
	echo "  the named overlays (with deps) and any currently active overlays." >&2
	echo "  Resource tokens (header comments, not DT props):" >&2
	echo "    * Resource-provides: tok, tok" >&2
	echo "    * Resource-requires: tok" >&2
	echo "    * Resource-revokes: tok" >&2
	echo "  plus alias:<key> derived from target-path=\"/aliases\" fragments." >&2
	echo "  No args = active only." >&2
}

# Parse resource tokens from .dts header comments (preferred) or legacy
# lc,<prop> = "a", "b"; DT properties. prop = provides|requires|revokes.
# Prints one token per line.
LDTO_lcStrings()
{
	local file="$1" prop="$2"
	[ -f "$file" ] || return 0
	local field
	case "$prop" in
		provides) field="Resource-provides" ;;
		requires) field="Resource-requires" ;;
		revokes) field="Resource-revokes" ;;
		*) return 0 ;;
	esac
	# Comment form: * Resource-provides: a, b
	local line
	while IFS= read -r line; do
		# strip leading " * Resource-provides:"
		line=${line#*:}
		line=${line//$'\r'/}
		local part
		IFS=',' read -ra _parts <<<"$line"
		for part in "${_parts[@]}"; do
			part=${part//\"/}
			part=$(echo "$part" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
			[ -n "$part" ] && printf '%s\n' "$part"
		done
	done < <(grep -iE "^[[:space:]]\*[[:space:]]*${field}[[:space:]]*:" "$file" 2>/dev/null || true)
	# If comments produced anything, skip legacy DT props
	if grep -qiE "^[[:space:]]\*[[:space:]]*${field}[[:space:]]*:" "$file" 2>/dev/null; then
		return 0
	fi
	# Legacy: lc,provides = "a", "b";
	tr '\n' ' ' <"$file" | \
		grep -oE "lc,${prop}[[:space:]]*=[[:space:]]*[^;]+;" | \
		grep -oE '"[^"]+"' | tr -d '"'
}

# Derive exclusive alias claims from fragment target-path = "/aliases".
# Keys come from the real property names under /aliases (not hand-coded).
# Prints one "alias:<key>" per line. Uses python3 when available; pure-bash
# fallback if not. If the file has /aliases but derivation fails → return 2.
LDTO_derivedAliasClaims()
{
	local file="$1"
	[ -f "$file" ] || return 0
	local has_aliases=0
	if grep -qE 'target-path[[:space:]]*=[[:space:]]*"/aliases"' "$file" 2>/dev/null; then
		has_aliases=1
	fi
	[ "$has_aliases" -eq 1 ] || return 0

	# local: callers run this in the caller's shell (not a subshell), and a
	# global $out clobbered LDTO_enableGateConflicts's report path
	local out line
	if command -v python3 >/dev/null 2>&1; then
		if out=$(python3 - "$file" <<'PY'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(errors="replace")

def extract_braced(s: str, open_idx: int) -> tuple[str, int]:
    depth = 0
    i = open_idx
    while i < len(s):
        if s[i] == "{":
            depth += 1
        elif s[i] == "}":
            depth -= 1
            if depth == 0:
                return s[open_idx + 1 : i], i + 1
        i += 1
    return s[open_idx + 1 :], len(s)

_SKIP = {
    "status", "compatible", "phandle", "name",
    "pinctrl-names", "clock-names", "sound-name-prefix",
}
seen: set[str] = set()
for m in re.finditer(r"fragment@\d+\s*\{", text):
    body, _ = extract_braced(text, m.end() - 1)
    if not re.search(r'target-path\s*=\s*"/aliases"', body):
        continue
    om = re.search(r"__overlay__\s*\{", body)
    if not om:
        continue
    ob, _ = extract_braced(body, om.end() - 1)
    for km in re.finditer(
        r'([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"([^"]*)"\s*;', ob
    ):
        key = km.group(1)
        if key in _SKIP:
            continue
        tok = f"alias:{key}"
        if tok not in seen:
            seen.add(tok)
            print(tok)
PY
		); then
			[ -n "$out" ] && printf '%s\n' "$out"
			return 0
		fi
		# fall through to bash fallback
	fi

	# Pure-bash fallback: line-oriented scan (good enough for normal LWT form)
	local in_aliases=0 in_overlay=0 key found=0
	local -A seen=()
	while IFS= read -r line || [ -n "$line" ]; do
		if [[ "$line" =~ target-path[[:space:]]*=[[:space:]]*\"/aliases\" ]]; then
			in_aliases=1
			in_overlay=0
			continue
		fi
		if [ "$in_aliases" -eq 1 ] && [[ "$line" =~ fragment@ ]]; then
			in_aliases=0
			in_overlay=0
		fi
		if [ "$in_aliases" -eq 1 ] && [[ "$line" =~ __overlay__ ]]; then
			in_overlay=1
			continue
		fi
		if [ "$in_overlay" -eq 1 ]; then
			if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*\" ]]; then
				key="${BASH_REMATCH[1]}"
				case "$key" in
					status|compatible|phandle|name|pinctrl-names|clock-names|sound-name-prefix) ;;
					*)
						if [ -z "${seen[$key]:-}" ]; then
							seen["$key"]=1
							found=1
							printf 'alias:%s\n' "$key"
						fi
						;;
				esac
			fi
			# end of overlay block (naive)
			if [[ "$line" =~ ^[[:space:]]*\}\;[[:space:]]*$ ]] && [ "$found" -eq 1 ]; then
				in_overlay=0
				in_aliases=0
			fi
		fi
	done <"$file"
	if [ "$found" -eq 0 ] && [ "$has_aliases" -eq 1 ]; then
		echo "WARNING: alias derivation found no keys in $file" >&2
		return 2
	fi
	return 0
}

# Exclusive claim tokens for conflict detection (R15).
# = Resource-provides (minus alias:*) ∪ Resource-revokes
#   ∪ (Resource-requires that are pin:|i2c:|excl:)
#   ∪ derived alias:<key> from /aliases fragments
# bus: requires stay out so provider+consumer do not false-conflict.
# Returns 2 if alias derivation is required but failed.
LDTO_exclusiveClaims()
{
	local dto="$1"
	local dts t rc=0
	dts=$(LDTO_getDTS "$dto")
	[ -n "$dts" ] && [ -f "$dts" ] || return 0
	while IFS= read -r t; do
		[ -z "$t" ] && continue
		case "$t" in
			alias:*) ;; # prefer derived
			*) printf '%s\n' "$t" ;;
		esac
	done < <(LDTO_lcStrings "$dts" provides)
	while IFS= read -r t; do
		[ -n "$t" ] && printf '%s\n' "$t"
	done < <(LDTO_lcStrings "$dts" revokes)
	while IFS= read -r t; do
		[ -z "$t" ] && continue
		case "$t" in
			pin:*|i2c:*|excl:*)
				printf '%s\n' "$t"
				;;
		esac
	done < <(LDTO_lcStrings "$dts" requires)
	LDTO_derivedAliasClaims "$dts" || rc=$?
	return "$rc"
}

LDTO_conflicts()
{
	if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
		LDTO_conflictsHelp
		return 0
	fi
	LDTO_loadMap
	LDTO_loadGpioMap
	LDTO_loadDeps

	local -a names=()
	local a
	for a in "$@"; do
		names+=("$a")
	done

	# Include active overlays (configfs status=applied only, same rule as
	# status/active; unapplied leftover dirs claim nothing). merge turns this
	# off: it gates against the overlays recorded in the next-boot override,
	# not against the running tree.
	local act
	if [ "${LDTO_CONFLICT_ACTIVES:-1}" = "1" ]; then
		while IFS= read -r act; do
			[ -n "$act" ] && names+=("$act")
		done < <(LDTO_listAppliedOverlays)
	fi

	if [ ${#names[@]} -eq 0 ]; then
		echo "$FUNCNAME: no overlays given and none active." >&2
		LDTO_conflictsHelp
		return 1
	fi

	local -a seq
	local seq_out
	seq_out=$(LDTO_expandDeps "${names[@]}") || return 1
	mapfile -t seq <<<"$seq_out"

	echo "Overlays considered (deps expanded): ${seq[*]}"
	echo

	# pin_key -> list of overlays
	local pins_blob
	pins_blob=$(
		for dto in "${seq[@]}"; do
			dto_real=$(LDTO_getAliasDT "$dto")
			[ -n "$dto_real" ] && dto=$dto_real
			LDTO_collectOverlayPins "$dto"
		done
	)

	if [ -z "$pins_blob" ]; then
		echo "No header pins resolved from overlays (need .dts + gpio.map)."
	else
		echo "Pin occupancy:"
		printf '  %-6s %-4s %-14s %s\n' "Header" "Pin" "Name" "Overlays"
		printf '%s\n' "$pins_blob" | awk -F '\t' '
			{
				key = $1 SUBSEP $2
				nm[key] = $3
				h[key] = $1
				p[key] = $2
				if (!seen[key, $4]++) {
					if (own[key] == "")
						own[key] = $4
					else
						own[key] = own[key] " " $4
				}
			}
			END {
				for (k in own)
					printf "%s\t%02d\t%s\t%s\t%s\n", h[k], p[k]+0, p[k], nm[k], own[k]
			}
		' | sort -t$'\t' -k1,1 -k2,2n | awk -F '\t' '{
			printf "  %-6s %-4s %-14s %s\n", $1, $3, $4, $5
		}'
	fi

	echo
	# Pin conflicts: same Header.Pin by unrelated overlays (bus→device OK).
	LDTO_loadDeps
	local pin_groups=""
	if [ -n "$pins_blob" ]; then
		pin_groups=$(
			printf '%s\n' "$pins_blob" | awk -F '\t' '
				{
					key = $1 "\t" $2 "\t" $3
					if (!seen[key, $4]++) {
						if (list[key] == "") list[key] = $4
						else list[key] = list[key] " " $4
						cnt[key]++
					}
				}
				END {
					for (k in cnt)
						if (cnt[k] > 1)
							print k "\t" list[k]
				}
			'
		)
	fi

	_ldto_is_related() {
		local a="$1" b="$2" x
		local -a exp
		# expansion errors already failed LDTO_conflicts on the full set
		mapfile -t exp < <(LDTO_expandDeps "$a" 2>/dev/null)
		for x in "${exp[@]}"; do
			[ "$x" = "$b" ] && return 0
		done
		mapfile -t exp < <(LDTO_expandDeps "$b" 2>/dev/null)
		for x in "${exp[@]}"; do
			[ "$x" = "$a" ] && return 0
		done
		# Resource-set relatedness: A requires a token that B provides (or vice versa).
		local dts_a dts_b
		dts_a=$(LDTO_getDTS "$a")
		dts_b=$(LDTO_getDTS "$b")
		[ -n "$dts_a" ] && [ -n "$dts_b" ] || return 1
		local -A prov_a=() prov_b=() req_a=() req_b=()
		while IFS= read -r x; do [ -n "$x" ] && prov_a["$x"]=1; done < <(LDTO_lcStrings "$dts_a" provides)
		while IFS= read -r x; do [ -n "$x" ] && prov_b["$x"]=1; done < <(LDTO_lcStrings "$dts_b" provides)
		while IFS= read -r x; do [ -n "$x" ] && req_a["$x"]=1; done < <(LDTO_lcStrings "$dts_a" requires)
		while IFS= read -r x; do [ -n "$x" ] && req_b["$x"]=1; done < <(LDTO_lcStrings "$dts_b" requires)
		for x in "${!req_a[@]}"; do
			[ -n "${prov_b[$x]:-}" ] && return 0
		done
		for x in "${!req_b[@]}"; do
			[ -n "${prov_a[$x]:-}" ] && return 0
		done
		return 1
	}

	local conf_tmp res_tmp
	conf_tmp=$(mktemp)
	res_tmp=$(mktemp)
	if [ -n "$pin_groups" ]; then
		while IFS=$'\t' read -r h p name owners; do
			[ -z "$owners" ] && continue
			local -a oarr=($owners)
			local i j related_all=1
			for ((i=0; i<${#oarr[@]}; i++)); do
				for ((j=i+1; j<${#oarr[@]}; j++)); do
					if ! _ldto_is_related "${oarr[i]}" "${oarr[j]}"; then
						related_all=0
						break 2
					fi
				done
			done
			if [ "$related_all" -eq 0 ]; then
				printf '%s\t%s\t%s\t%s\n' "$h" "$p" "$name" "$owners" >> "$conf_tmp"
			fi
		done <<<"$pin_groups"
	fi

	# R15: resource-token exclusivity (header Resource-* / exclusive requires + derived aliases)
	local -A claims_by_ov=()
	local dto tok line dto_real der_rc claims_tmp err_tmp
	local alias_derivation_failed=0
	claims_tmp=$(mktemp)
	err_tmp=$(mktemp)
	for dto in "${seq[@]}"; do
		dto_real=$(LDTO_getAliasDT "$dto")
		[ -n "$dto_real" ] && dto=$dto_real
		der_rc=0
		: >"$claims_tmp"
		LDTO_exclusiveClaims "$dto" >"$claims_tmp" 2>>"$err_tmp" || der_rc=$?
		if [ "$der_rc" -eq 2 ]; then
			alias_derivation_failed=1
		fi
		line=$(sort -u "$claims_tmp" | tr '\n' ' ')
		claims_by_ov["$dto"]="$line"
	done
	rm -f "$claims_tmp"
	if [ -s "$err_tmp" ]; then
		cat "$err_tmp" >&2
	fi
	rm -f "$err_tmp"
	if [ "$alias_derivation_failed" -eq 1 ]; then
		echo "WARNING: alias derivation failed for one or more overlays; refusing silent pass" >&2
		rm -f "$conf_tmp" "$res_tmp"
		return 1
	fi
	local -A tok_owners=()
	for dto in "${!claims_by_ov[@]}"; do
		for tok in ${claims_by_ov[$dto]}; do
			if [ -z "${tok_owners[$tok]:-}" ]; then
				tok_owners["$tok"]="$dto"
			else
				case " ${tok_owners[$tok]} " in
					*" $dto "*) ;;
					*) tok_owners["$tok"]="${tok_owners[$tok]} $dto" ;;
				esac
			fi
		done
	done
	local owners related_all
	local -a oarr
	for tok in "${!tok_owners[@]}"; do
		owners="${tok_owners[$tok]}"
		oarr=($owners)
		[ ${#oarr[@]} -lt 2 ] && continue
		related_all=1
		local i j
		for ((i=0; i<${#oarr[@]}; i++)); do
			for ((j=i+1; j<${#oarr[@]}; j++)); do
				if ! _ldto_is_related "${oarr[i]}" "${oarr[j]}"; then
					related_all=0
					break 2
				fi
			done
		done
		if [ "$related_all" -eq 0 ]; then
			printf '%s\t%s\n' "$tok" "$owners" >> "$res_tmp"
		fi
	done

	local has_pin=0 has_res=0
	[ -s "$conf_tmp" ] && has_pin=1
	[ -s "$res_tmp" ] && has_res=1

	if [ "$has_pin" -eq 0 ] && [ "$has_res" -eq 0 ]; then
		rm -f "$conf_tmp" "$res_tmp"
		if [ -z "$pins_blob" ] && [ ${#seq[@]} -gt 1 ]; then
			local any_claim=0
			for dto in "${!claims_by_ov[@]}"; do
				[ -n "${claims_by_ov[$dto]// }" ] && any_claim=1 && break
			done
			if [ "$any_claim" -eq 0 ]; then
				echo "WARNING: no pin map and no lc,* resource tokens among ${#seq[@]} overlays — exclusivity not checked" >&2
			fi
		fi
		echo "Conflicts: none (shared bus→device pins / related resource tokens OK)"
		return 0
	fi

	if [ "$has_pin" -eq 1 ]; then
		echo "Conflicts (unrelated overlays share a pin):"
		printf '  %-6s %-4s %-14s %s\n' "Header" "Pin" "Name" "Overlays"
		sort -t$'\t' -k1,1 -k2,2n "$conf_tmp" | awk -F '\t' '{
			printf "  %-6s %-4s %-14s %s\n", $1, $2, $3, $4
		}'
		echo
	fi
	if [ "$has_res" -eq 1 ]; then
		echo "Conflicts (unrelated overlays share a resource token):"
		printf '  %-28s %s\n' "Token" "Overlays"
		sort -t$'\t' -k1,1 "$res_tmp" | awk -F '\t' '{
			printf "  %-28s %s\n", $1, $2
		}'
	fi
	rm -f "$conf_tmp" "$res_tmp"
	return 2
}


LDTO_help(){
	echo "$0 list"
	echo "$0 status"
	echo "$0 active [DTBO]"
	echo "$0 enable [--dry-run|-n] [--no-preflight] [DTBO]  # deps + conflicts + live preflight"
	echo "$0 disable [DTBO]"
	echo "$0 info [DTBO]     # description, deps, gpio.map pinout"
	echo "$0 conflicts [DTBO]...  # pin occupancy / collisions (deps + active)"
	echo "$0 current"
	echo "$0 merge [--dry-run|-n] [DTBO]  # conflicts + chain preflight; atomic ESP write"
	echo "$0 show"
	echo "$0 diff"
	echo "$0 edit            # edit ESP override (dtc fail-closed)"
	echo "$0 reset"
}

LDTO_requireConfigFS()
{
	if [ ! -d "$PATH_OF_CONFIG" ]; then
		echo "The running kernel does not support this tool (configfs overlays)." >&2
		return 1
	fi
}

cmd=help
if [ ! -z "$1" ]; then
	cmd=$1
	shift
fi
cmd_lc=${cmd,,}
# R11: unknown subcommand → help, not bash "command not found"
if ! declare -F "LDTO_${cmd_lc}" >/dev/null 2>&1; then
	echo "$0: unknown command '$cmd'" >&2
	LDTO_help
	exit 1
fi
case "$cmd_lc" in
	help|list|info|conflicts)
		# host-side OK (no configfs / firmware)
		;;
	enable)
		# enable --dry-run does not need configfs
		dry=0
		for a in "$@"; do
			case "$a" in --dry-run|-n) dry=1 ;; esac
		done
		if [ "$dry" -eq 0 ]; then
			LDTO_requireConfigFS || exit 1
		fi
		;;
	merge|show|diff|reset|current|edit|status)
		# EFI / firmware DTB path — not configfs (status lists configfs
		# actives when present, and reports the next-boot DT either way)
		;;
	*)
		LDTO_requireConfigFS || exit 1
		;;
esac
LDTO_${cmd_lc} "$@"
